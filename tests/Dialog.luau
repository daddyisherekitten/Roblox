--!strict
return function(Parser: any,loadRenderTree: any,loadWordLayout: any,loadBlockLayout: any,Dialog: any)
	local renderer=loadRenderTree({create=function(_,parent,props)local gui=table.clone(props);gui.Parent=parent;function gui:Destroy()self.Parent=nil;self.Destroyed=true end;return gui end,modifier=function(_,_,props)return table.clone(props)end})
	local document=Parser.parse('<div style="height:20px;overflow:hidden"><button id="open" type="button" commandfor="d" command="show-modal">Open</button></div><dialog id="d" closedby="any" style="width:240px"><form id="f" method="dialog"><button id="ok" value="yes">OK</button></form></dialog><dialog id="locked" closedby="none"><button type="button">Locked</button></dialog>')
	local viewport={AbsolutePosition=Vector2.new(7,11)}
	local root={Parent=viewport,AbsolutePosition=Vector2.new(17,26)}
	local tree=renderer.build(document,root,error)
	Dialog.attachViewport(tree,root)
	assert(#tree.Dialogs==2 and tree.DialogHost and not tree.DialogHost.Backdrop.Visible and not tree.DialogHost.Layer.Visible)
	assert(tree.DialogHost.Backdrop.Active==false,'The shared factory invariant keeps the backdrop inactive')
	assert(tree.DialogHost.Backdrop.BackgroundTransparency==0.9 and tree.DialogHost.Backdrop.BackgroundColor3==Color3.new(0,0,0),'The default backdrop matches the browser UA black at 10% opacity')
	local d,locked=tree.Dialogs[1],tree.Dialogs[2]
	assert(not d.Open and not d.Box.Gui.Visible and Dialog.hidden(tree,d.Node))
	local controls={};for _,control in tree.Controls do controls[control.Node.Attributes.id or '']=control end
	assert(Dialog.command(tree,controls.open)==d and d.Open and d.Modal and d.Node.Attributes.open=='' and tree.DialogHost.Layer.Visible)
	assert(tree.ActiveModal==d and tree.DialogHost.Backdrop.Visible and Dialog.allows(tree,controls.ok.Node) and not Dialog.allows(tree,controls.open.Node))
	d.Box.Gui.AbsolutePosition=Vector2.new(100,80);d.Box.Gui.AbsoluteSize=Vector2.new(240,120)
	assert(Dialog.dismissAt(tree,Vector2.new(150,100))==nil and d.Open,'A click within the dialog must remain inside')
	assert(Dialog.dismissAt(tree,Vector2.new(20,20))==d and not d.Open and not tree.DialogHost.Backdrop.Visible and not tree.DialogHost.Layer.Visible,'closedby=any dismisses through the backdrop')
	Dialog.open(tree,d.Node,true)
	assert(Dialog.cancel(tree)==d and not d.Open and not tree.DialogHost.Backdrop.Visible)
	Dialog.open(tree,locked.Node,true)
	assert(Dialog.cancel(tree)==nil and locked.Open,'closedby=none suppresses Escape cancellation')
	Dialog.close(tree,locked.Node)
	Dialog.open(tree,d.Node,true)
	local form=d.Node.Children[1]
	assert(Dialog.closeForm(tree,form,controls.ok)==d and d.ReturnValue=='yes' and not d.Open)
	local words=loadWordLayout({
		['Layout/FontProfiles']={face=function(font)return font end},
		['Layout/TextMeasure']={measure=function(text,_,size)return {X=if text==' ' then 4 else #text*8,Y=size} end},
	})
	local block=loadBlockLayout({['Layout/WordLayout']=words})
	tree.ViewportHeight=300
	local height,width=block.arrange(tree,100,0,0,function()return true end)
	assert(height==20 and width==100,'Closed or open top-layer dialogs do not extend document flow or canvas: '..tostring(width)..'x'..tostring(height))
	assert(d.Box.OuterHeight>0 and d.Box.OuterHeight<300,'An auto-height dialog must fit its content instead of stretching to the viewport')
	root.AbsoluteSize=Vector2.new(500,300);root.AbsoluteWindowSize=Vector2.new(500,300);root.CanvasPosition=Vector2.new(0,40)
	Dialog.open(tree,d.Node,false)
	block.arrange(tree,500,0,0,function()return true end)
	Dialog.arrange(tree,root)
	assert(tree.DialogHost.Layer.Position[1]==10 and tree.DialogHost.Layer.Position[2]==15,'Viewport overlay is positioned independently of CanvasPosition')
	assert(d.Box.Gui.Parent==root and d.Box.Gui.Position[1]==(500-d.Box.OuterWidth)/2 and d.Box.Gui.Position[2]==d.Box.PaintY,'A non-modal dialog uses ordinary document positioning inside the scrolling page')
	Dialog.open(tree,d.Node,true);block.arrange(tree,500,0,0,function()return true end);Dialog.arrange(tree,root)
	assert(d.Box.Gui.Parent==tree.DialogHost.Layer and d.Box.Gui.Position[2]==(300-d.Box.OuterHeight)/2,'A modal dialog is centered in the fixed viewport layer')
	block.arrange(tree,500,0,0,function()return true end)
	Dialog.arrange(tree,root)
	assert(d.Box.Gui.Parent==tree.DialogHost.Backdrop.Parent and d.Box.Gui.ZIndex>tree.DialogHost.Backdrop.ZIndex,'Publishing a new layout restores the modal above its backdrop')
	Dialog.destroyHost(tree);assert(tree.DialogHost==nil,'Detached viewport overlays are destroyed with the page')
	local styled=renderer.build(Parser.parse('<dialog id="styled">Styled</dialog>'),root,error,nil,nil,nil,nil,'dialog::backdrop { background:rgb(10 40 32 / .65) }')
	Dialog.attachViewport(styled,root)
	Dialog.open(styled,'styled',true)
	assert(math.abs(styled.DialogHost.Backdrop.BackgroundTransparency-0.35)<0.001,'Author ::backdrop alpha controls the modal overlay')
	assert(styled.DialogHost.Backdrop.BackgroundColor3==Color3.fromRGB(10,40,32),'Modern RGB ::backdrop color controls the modal overlay')
	Dialog.destroyHost(styled)
	local retained=renderer.build(Parser.parse('<button id="outside">Outside</button><div id="owner"><dialog id="retained" closedby="any"><button>Inside</button></dialog></div>'),root,error)
	Dialog.attachViewport(retained,root)
	local state=retained.Dialogs[1];local owner=state.Node.Parent
	Dialog.open(retained,state.Node,true)
	state.Box.Gui.AbsolutePosition=Vector2.new(100,80);state.Box.Gui.AbsoluteSize=Vector2.new(140,80)
	owner.Attributes.style='content-visibility:hidden';retained:RefreshDOMStyles({[owner]=true})
	assert(state.Open and state.Modal and retained.ActiveModal==state and retained.CSSStates.modal[state.Node],'Skipping preserves the HTML modal state and inert background')
	assert(not state.Box.Gui.Visible and not retained.DialogHost.Backdrop.Visible and not retained.DialogHost.Layer.Visible,'A skipped modal generates neither a dialog surface nor a backdrop')
	assert(Dialog.surfaceAt(retained,{retained.DialogHost.Backdrop,retained.DialogHost.Layer})==nil,'Hidden retained overlay objects cannot be hit surfaces')
	assert(Dialog.dismissAt(retained,Vector2.new(120,100))==state and not state.Open,'Stale retained dialog geometry does not suppress light dismissal while skipped')
	Dialog.open(retained,state.Node,true)
	assert(Dialog.cancel(retained)==state and not state.Open,'A hidden modal still responds to its close watcher')
	Dialog.destroyHost(retained)
	print('Dialog: states, declarative commands, modal backdrop, light dismissal, cancellation, form return value, focus boundary and top-layer layout passed')
end
