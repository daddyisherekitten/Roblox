--!strict
-- Pure Luau tests; also used by the command-line runner outside Roblox.
return function(Parser: any, Node: any)
	local count = 0
	local function check(value: any, message: string)
		assert(value, message)
		count += 1
	end
	local doc = Parser.parse([[<!DOCTYPE html><DIV id="main" class='card' data-width=20><p>Hello &amp; <span>Roblox</span>!</p><img src="rbxassetid://123"><input disabled checked></DIV>]])
	local main = Node.findById(doc, "main")
	check(main and main.Name == "div", "Case-insensitive tag names")
	check(main.Attributes.class == "card" and main.Attributes["data-width"] == "20", "Attribute formats")
	check(main.Children[2].Name == "img" and main.Children[3].Name == "input", "Void siblings")
	check(main.Children[3].Attributes.checked == "" and main.Children[3].Attributes.disabled == "", "Boolean attributes")
	check(Node.textContent(main) == "Hello & Roblox!", "Decoded nested text in order")
	check(main.Parent == doc and main.Children[1].Parent == main, "Parent links")
	check(#doc.Diagnostics == 0, "Valid example should have no warnings")
	check(doc.Kind=='Document'and doc.LegacyFragment==true and doc.DocumentElement==nil,'Legacy parseHTML retains its flat Document-shaped fragment contract')
	check(Node.cloneNode(doc,true).LegacyFragment==true,'Cloning a legacy fragment host retains its parsing contract')
	local entities = Parser.parse("&lt; &gt; &quot; &apos; &nbsp; &#65; &#x1F600; &#0; &#xD800; &unknown; &amp;lt;")
	check(Node.textContent(entities) == '< > " \' ' .. utf8.char(160) .. " A " .. utf8.char(0x1F600) .. " " .. utf8.char(0xFFFD) .. " " .. utf8.char(0xFFFD) .. " &unknown; &lt;", "Single-pass entity decoding")
	local raw = Parser.parse([[<script>if (a < b) x = "&amp;";</SCRIPT><style>a>b{content:"<"}</style><textarea>&amp;<b>x</b></textarea>]])
	check(raw.Children[1].Children[1].Text == 'if (a < b) x = "&amp;";', "Script stays inert and raw")
	check(raw.Children[2].Children[1].Text == 'a>b{content:"<"}', "Styles stay raw")
	check(raw.Children[3].Children[1].Text == "&<b>x</b>", "Textarea decodes without parsing tags")
	local rawBoundary = Parser.parse("<script>a</scriptx>b</script><p>ok</p>")
	check(rawBoundary.Children[1].Children[1].Text == "a</scriptx>b", "Raw end-name boundary")
	local rawSlash = Parser.parse("<script>a</script/><p>visible</p>")
	check(rawSlash.Children[1].Children[1].Text == "a" and rawSlash.Children[2].Name == "p", "Malformed raw end tags must not swallow following elements")
	check(#rawSlash.Diagnostics == 1 and rawSlash.Diagnostics[1].Code == "invalid-end-tag", "Malformed raw end tag retains its diagnostic")
	local trailingSpace = Parser.parse("<div   ")
	for _, diagnostic in trailingSpace.Diagnostics do check(diagnostic.Code ~= "invalid-attribute", "End-of-input whitespace is not an attribute") end
	check(Node.textContent(Parser.parse("<p>1 < 2 << 3</p>")) == "1 < 2 << 3", "Literal angle brackets")
	local comment = Parser.parse("a<!-- hidden -->b")
	check(comment.Children[2].Kind == "Comment" and Node.textContent(comment) == "ab", "Comments are not text content")
	local duplicate = Parser.parse('<div ID="first" id="second" title="a>b"></div>')
	check(Node.findById(duplicate, "first").Attributes.title == "a>b", "First duplicate wins and quoted > survives")
	check(duplicate.Diagnostics[1].Code == "duplicate-attribute", "Duplicate warning")
	local slash = Parser.parse('<img src=x/><div/>inside</div>')
	check(slash.Children[1].Attributes.src == "x/", "Unquoted trailing slash belongs to attribute")
	check(slash.Children[2].Children[1].Text == "inside", "Non-void self-close ignored")
	local recovery = Parser.parse("</missing><div><b>x</div>")
	check(Node.textContent(recovery) == "x" and #recovery.Diagnostics == 2, "Bounded malformed recovery")
	check(Node.textContent(Parser.parse("\239\187\191a\r\nb\rc")) == "a\nb\nc", "BOM and newline normalization")
	local unclosed = Parser.parse('<div title="unfinished')
	check(#unclosed.Diagnostics > 0, "Unclosed attributes terminate with diagnostics")
	local warnings = Parser.parse(string.rep("</missing>", 20), { MaxDiagnostics = 3 })
	check(#warnings.Diagnostics == 3 and warnings.DiagnosticsTruncated, "Diagnostic cap")
	for _, case in {
		{ "12345", { MaxBytes = 4 } },
		{ "<br><br>", { MaxNodes = 2 } },
		{ "<div><span>x</span></div>", { MaxDepth = 1 } },
		{ "", { MaxBytes = 0 } },
	} do
		check(not pcall(Parser.parse, case[1], case[2]), "Limits must reject excessive input")
	end
	local stress = string.rep("<", 20000)
	check(Node.textContent(Parser.parse(stress)) == stress, "Repeated invalid brackets remain text")
	local children = Parser.parse(string.rep("<p>x</p>", 1000))
	check(children.NodeCount == 2001 and #children.Children == 1000, "Many siblings retain node accounting")
	check(Node.textContent(Parser.parse("")) == "", "Empty input")
	check(not pcall(Node.append, main.Children[1], main), "Do not attach an already-parented node")
	local templates = Parser.parse('<div id="outside">Before</div><template id="card"><article id="inside">A<template id="nested"><b>B</b></template></article><!--kept--></template><p id="after">After</p>')
	local template = Node.findById(templates, "card")
	check(template and template.Content and template.Content.Kind == "DocumentFragment" and template.Content.Host == template, "Template owns an inert document fragment")
	check(#template.Children == 0 and Node.findById(templates, "inside") == nil and Node.findById(template.Content, "inside") ~= nil, "Template content is outside the active document tree")
	check(Node.textContent(template) == "" and Node.textContent(template.Content) == "A" and Node.findById(templates, "after"), "Template contents stay inert without swallowing following siblings")
	local clonedTemplate = Node.cloneNode(template, true)
	check(clonedTemplate ~= template and clonedTemplate.Content.Host == clonedTemplate and Node.textContent(clonedTemplate.Content) == "A", "Deep cloneNode copies template contents into an independent fragment")
	local clonedInside = Node.findById(clonedTemplate.Content, "inside")
	clonedInside.Attributes.id = "clone-inside"
	check(Node.findById(template.Content, "inside") ~= nil and Node.findById(clonedTemplate.Content, "clone-inside") == clonedInside, "Template clones do not share attributes or descendants")
	local nestedClone = Node.findById(clonedTemplate.Content, "nested")
	check(nestedClone and nestedClone.Content and Node.textContent(nestedClone.Content) == "B" and nestedClone.Content.Host == nestedClone, "Nested template fragments clone recursively")
	check(#Node.cloneNode(template, false).Content.Children == 0, "Shallow template clones start with an empty content fragment")
	check(Parser.parse('<template><span>x</span></template>').NodeCount == 5, "Template fragments participate in parser node limits and accounting")
	local shadowDocument = Parser.parse('<profile-card id="shadow-host"><span id="light-title" slot="title">Light</span><template shadowrootmode="open" shadowrootclonable shadowrootserializable shadowrootdelegatesfocus><section id="shadow-shell"><slot name="title">Fallback</slot><slot>Body fallback</slot></section></template></profile-card>')
	local shadowHost = Node.findById(shadowDocument, "shadow-host")
	check(shadowHost and shadowHost.InternalShadowRoot == shadowHost.ShadowRoot and shadowHost.ShadowRoot.Kind == "ShadowRoot" and shadowHost.ShadowRoot.Mode == "open", "Declarative open shadow roots attach to their host")
	check(shadowHost.ShadowRoot.Clonable and shadowHost.ShadowRoot.Serializable and shadowHost.ShadowRoot.DelegatesFocus, "Declarative shadow metadata is preserved")
	check(#shadowHost.Children == 1 and Node.findById(shadowDocument, "shadow-shell") == nil and Node.findById(shadowHost.ShadowRoot, "shadow-shell") ~= nil, "Shadow contents are isolated from document traversal")
	check(shadowDocument.NodeCount == 10, "Attached shadow roots count reachable nodes without the consumed template element")
	local shadowClone = Node.cloneNode(shadowHost, true)
	check(shadowClone.ShadowRoot and shadowClone.ShadowRoot ~= shadowHost.ShadowRoot and shadowClone.ShadowRoot.Host == shadowClone and Node.findById(shadowClone.ShadowRoot, "shadow-shell"), "Clonable shadow roots receive independent deep copies")
	local closedHost = Node.findById(Parser.parse('<secret-box id="closed"><template shadowrootmode="closed"><p id="secret">Secret</p></template></secret-box>'), "closed")
	check(closedHost.InternalShadowRoot and closedHost.ShadowRoot == nil and Node.findById(closedHost.InternalShadowRoot, "secret"), "Closed roots stay internally renderable without a public ShadowRoot field")
	local inertShadowTemplate = Node.findById(Parser.parse('<template id="outer"><x-card><template shadowrootmode="open"><slot></slot></template></x-card></template>'), "outer")
	local inertHost = inertShadowTemplate.Content.Children[1]
	check(inertHost.InternalShadowRoot == nil and inertHost.Children[1].Content ~= nil, "Declarative roots inside inert templates stay inert")
	local page = Parser.parseDocument('<title>Implicit</title><meta name="theme-color" content="blue"><p id="page">Body</p>')
	check(page.DocumentElement.Name == "html" and page.Head.Name == "head" and page.Body.Name == "body", "Document mode creates html/head/body")
	check(not page.LegacyFragment and not Node.cloneNode(page,true).LegacyFragment,'Full documents and their clones are real document-root contexts')
	check(page.Head.Children[1].Name == "title" and page.Head.Children[2].Name == "meta" and Node.findById(page.Body, "page"), "Leading metadata enters head and flow content enters body")
	local explicit = Parser.parseDocument('<html lang="de"><body><p>Explicit</p></body></html>')
	check(explicit.DocumentElement.Attributes.lang == "de" and explicit.DocumentElement.Children[1].Name == "head" and explicit.DocumentElement.Children[2] == explicit.Body, "Document mode preserves explicit root/body and inserts a missing head")
	local reused=Parser.parse('<input id="legacy">')
	Node.removeChild(reused,reused.Children[1])
	local rewritten=Parser.parseDocument('<html><body>Replaced</body></html>',{_Document=reused})
	check(rewritten==reused and not rewritten.LegacyFragment and rewritten.DocumentElement.Name=='html','The full builder clears the legacy marker when document.open reuses the host')
	print(string.format("HTML parser: %d checks passed", count))
end
