--!strict
return function(URL: any)
	local value=URL.resolve('/main/index.html','../css-background-position/index.html#top')
	assert(value.Kind=='internal' and value.Path=='/css-background-position/index.html' and value.Fragment=='top')
	value=URL.resolve('/main/index.html','#top')
	assert(value.Path=='/main/index.html' and value.Fragment=='top')
	value=URL.resolve('/main/index.html','?mode=compact#top')
	assert(value.Path=='/main/index.html' and value.Query=='mode=compact' and value.Fragment=='top')
	value=URL.resolve('/main/index.html','https://example.com/path?q=1#x')
	assert(value.Kind=='external' and value.Scheme=='https' and value.Path=='/path')
	value=URL.resolve('http://localhost:8000/main/index.html','../css-background-position/index.html#top')
	assert(value.Kind=='external' and value.Origin=='http://localhost:8000' and value.URL=='http://localhost:8000/css-background-position/index.html#top')
	assert(URL.routeKey(value.URL)==URL.routeKey('http://localhost:8000/css-background-position/'))
	assert(URL.path(value.URL)=='/css-background-position/index.html')
	value=URL.resolve('/main/index.html','mailto:hello@example.com')
	assert(value.Kind=='external' and value.Scheme=='mailto')
	assert(URL.routeKey('/css-background-position/')==URL.routeKey('/css-background-position/index.html'))
	assert(URL.decodeFragment('hello%20world')=='hello world')
	print('Links: relative/absolute paths, queries, fragments, directory aliases and external schemes passed')
end
