--!strict
return function(Parser,Node,Structure,Sources,Pixels)
	local ns='http://www.w3.org/2000/svg'
	local function wrap(body) return '<svg xmlns="'..ns..'">'..body..'</svg>' end
	local function invalid(svg,code,options)
		local doc=Parser.parse(svg,options)
		assert(not doc.Valid and doc.Root==nil and #doc.Children==0 and next(doc.Ids)==nil,'Invalid documents cannot produce partial graphics')
		local found=false
		for _,d in doc.Diagnostics do if d.Code==code then found=true end end
		assert(found,'Missing diagnostic: '..code)
	end
	local svg='<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'..wrap('<title>A &amp; B &#x1F600;</title><desc><![CDATA[<literal> & data]]></desc><g id="Group"><rect id="Cell" viewBox="A" viewbox="B"/></g>')
	local doc=Parser.parse(svg)
	assert(doc.Valid,doc.Diagnostics[1] and doc.Diagnostics[1].Message)
	assert(doc.Root.Name=='svg' and doc.Root.NamespaceURI==ns)
	assert(doc.Ids.Group.Children[1]==doc.Ids.Cell and doc.Ids.Cell.Parent==doc.Ids.Group)
	assert(doc.Ids.Cell.Attributes.viewBox=='A' and doc.Ids.Cell.Attributes.viewbox=='B','XML names preserve case')
	assert(Node.findById(doc,'cell')==nil and Node.findById(doc,'Cell')==doc.Ids.Cell)
	assert(Node.textContent(doc.Root.Children[1])=='A & B '..utf8.char(0x1F600))
	assert(Node.textContent(doc.Root.Children[2])=='<literal> & data')
	doc=Parser.parse('<s:svg xmlns:s="'..ns..'" xmlns:x="urn:a"><s:g x:id="foreign" id="plain"><s:rect xmlns:x="urn:b" x:id="inner"/></s:g></s:svg>')
	assert(doc.Valid and doc.Ids.plain and not doc.Ids.foreign)
	local child=doc.Ids.plain.Children[1]
	assert(child.ExpandedAttributes['urn:b\0id']=='inner' and doc.Ids.plain.ExpandedAttributes['urn:a\0id']=='foreign')
	assert(doc.Ids.plain.ExpandedAttributes['\0id']=='plain','Default namespace never applies to unprefixed attributes')
	doc=Parser.parse(wrap('<g xmlns="urn:foreign"><rect/></g><g id="svg-group"/>'))
	assert(doc.Valid and doc.Root.Children[1].Children[1].NamespaceURI=='urn:foreign' and doc.Ids['svg-group'].NamespaceURI==ns)
	assert(Parser.parse('<svg/>',{Inline=true}).Valid)
	assert(Parser.parse(wrap(string.rep('<g>',127)..string.rep('</g>',127))).Valid,'Namespace lookup remains valid at the depth limit')
	assert(Parser.parse(wrap('<g id="Ä"><é:rect xmlns:é="'..ns..'"/></g>')).Valid,'Unicode XML names')
	doc=Parser.parse(wrap('<g id="a"/><g id="a"/>'))
	assert(doc.Valid and doc.Ids.a==doc.Root.Children[1] and doc.Diagnostics[1].Code=='duplicate-id')
	doc=Parser.parse(wrap('<g data="a\tb&#10;c"/>'))
	assert(doc.Root.Children[1].Attributes.data=='a b\nc','Literal whitespace normalized, character references preserved')
	invalid('<svg/>','invalid-root')
	invalid(wrap('<G></g>'),'mismatched-end-tag')
	invalid(wrap('<g>'),'mismatched-end-tag')
	invalid('<svg xmlns="'..ns..'">','unclosed-element')
	invalid(wrap('')..wrap(''),'multiple-roots')
	invalid('text'..wrap(''),'outside-root')
	invalid(wrap('<rect width=10/>'),'unquoted-attribute')
	invalid(wrap('<rect x="1"x="2"/>'),'invalid-start-tag')
	invalid(wrap('<rect x="1" x="2"/>'),'duplicate-attribute')
	invalid(wrap('<g xmlns:a="urn:q" xmlns:b="urn:q" a:x="1" b:x="2"/>'),'duplicate-expanded-attribute')
	invalid(wrap('<p:g/>'),'unbound-prefix')
	invalid(wrap('<g p:attr="x"/>'),'unbound-prefix')
	for _,binding in {'xmlns:xml="urn:no"','xmlns:p=""','xmlns="http://www.w3.org/XML/1998/namespace"','xmlns:p="http://www.w3.org/2000/xmlns/"'} do invalid(wrap('<g '..binding..'/>'),'invalid-namespace') end
	invalid(wrap('<g>&nbsp;</g>'),'invalid-entity')
	invalid(wrap('&#0;'),'invalid-entity')
	invalid(wrap('&#xD800;'),'invalid-entity')
	invalid(wrap('a & b'),'invalid-entity')
	invalid(wrap('<g x="<"/>'),'invalid-attribute')
	invalid(wrap('<!-- a--b -->'),'invalid-comment')
	invalid(wrap('<![CDATA[x'),'unclosed-cdata')
	invalid(wrap(']]>'),'invalid-text')
	invalid('<!DOCTYPE svg SYSTEM "file:///never-read">'..wrap(''),'unsupported-declaration')
	invalid('<?xml version="1.1"?>'..wrap(''),'unsupported-xml-version')
	invalid('<?xml version="1.0"><g?>'..wrap(''),'invalid-xml-declaration')
	invalid('<?xml version="1.&#48;"?>'..wrap(''),'invalid-xml-declaration')
	invalid(' <?xml version="1.0"?>'..wrap(''),'invalid-xml-declaration')
	invalid(wrap(string.char(0)),'invalid-character')
	invalid(wrap(string.char(255)),'invalid-utf8')
	invalid(wrap(''),'byte-limit',{MaxBytes=5})
	invalid(wrap('<g><g/></g>'),'depth-limit',{MaxDepth=2})
	invalid(wrap('<g/><g/>'),'node-limit',{MaxNodes=2})
	invalid(wrap('<g a="1" b="2"/>'),'attribute-limit',{MaxAttributes=1})
	invalid(wrap('<g id="a"/><g id="a"/><g>'),'mismatched-end-tag',{MaxDiagnostics=1})
	local clean=Parser.parse(wrap('<rect/>')); assert(clean.Valid,'Errors do not contaminate later parses')
	local data=Structure(Parser,Sources)
	assert(#data.Scenes==3 and #data.Scenes[1].Shapes==3 and #data.Scenes[2].Shapes==0 and #data.Scenes[3].Shapes==1)
	assert(#data.Diagnostics==1 and data.Diagnostics[1].Code=='mismatched-end-tag')
	local bytes=Pixels.render(data.Scenes[1],{},480,nil)
	local function red(x,y) return buffer.readu8(bytes,(y*480+x)*4) end
	assert(red(30,30)==229 and red(70,70)==30 and red(110,110)==67,'Runtime DOM produces nested RGB rectangles')
	assert(buffer.readu8(bytes,3)==0,'Definition covering the whole canvas is not painted')
	local blank=Pixels.render(data.Scenes[2],{},480,nil)
	for i=0,buffer.len(blank)-1 do assert(buffer.readu8(blank,i)==0,'Invalid SVG must remain completely empty') end
	local neighbor=Pixels.render(data.Scenes[3],{},480,nil)
	assert(buffer.readu8(neighbor,(20*480+30)*4+1)==160,'Valid neighbor survives the error')
	print('SVG S02: strict UTF-8 XML, namespace scope/case, entities/CDATA, IDs, limits, isolated errors and runtime DOM visual fixtures passed')
end
