--!strict
return function(load,fixture)
	local f=fixture();local API=load(f)
	local manager=API.new(f.Screen,{Animations=false,Services={Create=f.Create,Input=f.Input,PlayerGui=f.PlayerGui}})
	local window=manager:Open({Title='Close request'})
	local calls=0
	window:SetCloseGuard(function(value)assert(value==window);calls+=1;return false end)
	f:Click(window.CloseButton)
	assert(window.Alive and calls==1,'The native caption X must request permission before closing')
	window:SetCloseGuard(function()calls+=1;return true end)
	assert(window:RequestClose()and not window.Alive and calls==2,'An accepted request closes the native window')
	assert(not window:RequestClose(),'Repeated requests on disposed windows are inert')
	window=manager:Open({Title='Pending prompt'})
	local pendingCalls=0;local result=nil
	window:SetCloseGuard(function()pendingCalls+=1;return coroutine.yield('native-prompt')end)
	local pending=coroutine.create(function()result=window:RequestClose()end)
	local ok,yielded=coroutine.resume(pending)
	assert(ok and yielded=='native-prompt'and window.Alive and window.CloseRequestPending)
	assert(not window:RequestClose()and pendingCalls==1,'A pending prompt coalesces further close requests')
	assert(coroutine.resume(pending,false))
	assert(result==false and window.Alive and not window.CloseRequestPending,'A canceled yielding guard releases the request lock')
	pending=coroutine.create(function()result=window:RequestClose()end);assert(coroutine.resume(pending))
	window:SetCloseGuard(function()return false end)
	assert(coroutine.resume(pending,true))
	assert(result==false and window.Alive,'Replacing a guard invalidates a stale successful response')
	window:SetCloseGuard(function()error('Host prompt failed')end)
	assert(not pcall(window.RequestClose,window)and not window.CloseRequestPending,'Guard errors must release the request lock')
	window:SetCloseGuard(nil);assert(window:RequestClose()and not window.Alive,'Removing a guard restores ordinary close behavior')
	local owner=manager:Open({Title='Owner'})
	local child=manager:Open({Title='Owned',Owner=owner})
	local teardownGuard=0
	owner:SetCloseGuard(function()teardownGuard+=1;return false end)
	child:SetCloseGuard(function()teardownGuard+=1;return false end)
	assert(owner:Close()and not child.Alive and teardownGuard==0,'Forced owner disposal must bypass both guards')
	local late=manager:Open({Title='Disposed during confirmation'})
	late:SetCloseGuard(function()return coroutine.yield()end)
	pending=coroutine.create(function()result=late:RequestClose()end);assert(coroutine.resume(pending))
	manager:Destroy();assert(coroutine.resume(pending,true))
	assert(result==false and not late.Alive and late.CloseGuard==nil and late.Native.requestClose==nil,'Late prompt completion cannot close a different window or retain its binding')
	f:Drain();assert(f:GlobalConnections()==0,'Close guards must not introduce native event subscriptions')
	print('WindowCloseGuard: caption routing, cancellation, yielding/duplicate guards, stale results, forced owner teardown and cleanup passed')
end
