[
  {
    "name": "variable opacity remains unclamped until additive composition",
    "css": "#box{opacity:.4;--low:-.5;--high:.5}",
    "source": "const a=hold({opacity:['var(--low)','var(--high)']},{duration:100,composite:'add',fill:'both'},50);record(getComputedStyle(box).opacity);a.commitStyles();a.cancel();record(box.style.opacity);",
    "actual": [
      "0.4",
      "0.4"
    ],
    "error": null
  },
  {
    "name": "nonlinear percentage lengths keep their basis through commit",
    "css": "#parent{width:400px}#box{width:100px}",
    "source": "const a=hold({width:['min(20%, 100px)','max(40%, 100px)']},{duration:100,fill:'both'},50);record(Math.round(box.getBoundingClientRect().width));a.commitStyles();a.cancel();record(Math.round(box.getBoundingClientRect().width));parent.style.width='600px';record(Math.round(box.getBoundingClientRect().width));",
    "actual": [
      "120",
      "120",
      "170"
    ],
    "error": null
  },
  {
    "name": "additive nonlinear percentage keeps live underlying expression",
    "css": "#parent{width:400px}#box{width:10%}",
    "source": "const a=hold({width:['min(20%, 100px)','max(40%, 100px)']},{duration:100,composite:'add',fill:'both'},50);record(Math.round(box.getBoundingClientRect().width));a.commitStyles();a.cancel();record(Math.round(box.getBoundingClientRect().width));parent.style.width='600px';record(Math.round(box.getBoundingClientRect().width));",
    "actual": [
      "160",
      "160",
      "230"
