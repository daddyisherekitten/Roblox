    "name": "base mutations expose expanded attribute names",
    "html": "<base id=a>",
    "source": "const a=document.getElementById('a'),records=[];const observer=new MutationObserver(changes=>{for(const r of changes)records.push(r.attributeName+'|'+r.attributeNamespace+'|'+r.oldValue)});observer.observe(a,{attributes:true,attributeOldValue:true});a.setAttributeNS('urn:foreign','p:href','one');a.setAttributeNS('urn:foreign','q:href','two');a.removeAttributeNS('urn:foreign','href');a.href='../active/';Promise.resolve().then(()=>{console.log(records.join(';'));observer.disconnect()});",
    "documentURL": "https://docs.test/docs/page",
    "expected": [
