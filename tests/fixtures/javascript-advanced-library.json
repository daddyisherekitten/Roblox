    "source": "var log=[],s=new AsyncDisposableStack();s.defer(function(){log.push('first');return Promise.resolve().then(function(){log.push('first done')})});s.defer(function(){log.push('second');return Promise.resolve().then(function(){log.push('second done')})});var p=s.disposeAsync();record(s.disposed);record(log.join('|'));p.then(function(){record(log.join('|'));record('done')});",
    "expected": [
