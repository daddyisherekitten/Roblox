  {
    "name": "AsyncDisposableStack adopt defer move receiver identity",
    "source": "var log=[],s=new AsyncDisposableStack();s.adopt(3,function(v){'use strict';log.push(v+':'+(this===undefined));return Promise.resolve()});s.defer(function(){'use strict';log.push(this===undefined)});var m=s.move();record(s.disposed+','+m.disposed);s.disposeAsync().then(function(){record('old done')});m.disposeAsync().then(function(){record(log.join('|'));record(m.disposed)});",
    "expected": [
      "true,false",
      "old done",
      "true|3:true",
      "true"
    ]
  },
  {
    "name": "AsyncDisposableStack sync throw waits before next disposer",
    "source": "var log=[],s=new AsyncDisposableStack();s.defer(function(){log.push('last')});s.use({[Symbol.dispose](){log.push('throw');throw 'x'}});var p=s.disposeAsync();record(log.join('|'));p.catch(function(e){record(e);record(log.join('|'))});",
    "expected": [
      "throw",
      "x",
      "throw|last"
    ]
  },
  {
    "name": "Resource stack captures getter once and rejects bad async method",
    "source": "var count=0,log=[],s=new DisposableStack(),r={get [Symbol.dispose](){count++;return function(){log.push(this===r)}}};s.use(r);s.dispose();record(count);record(log.join('|'));var a=new AsyncDisposableStack();try{a.use({[Symbol.asyncDispose]:1,get [Symbol.dispose](){record('wrong getter');return function(){}}})}catch(e){record(e.name)}record(a.disposed);",
    "expected": [
      "1",
      "true",
      "TypeError",
      "false"
    ]
  },
