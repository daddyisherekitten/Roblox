    "name": "AsyncDisposableStack prefers async and ignores sync result",
    "source": "var log=[],s=new AsyncDisposableStack();s.use({[Symbol.dispose](){log.push('sync');return {get then(){log.push('ignored');throw 1}}}});s.use({[Symbol.asyncDispose](){log.push('async');return Promise.resolve().then(function(){log.push('async done')})},[Symbol.dispose](){log.push('wrong')}});s.disposeAsync().then(function(){record(log.join('|'))});",
    "expected": [
