    "source": "var log=[],s=new AsyncDisposableStack();s.defer(function(){log.push('defer')});s.use(null);var p=s.disposeAsync();record(log.join('|'));p.then(function(){record(log.join('|'));record(s.disposed);s.disposeAsync().then(function(){record('again')})});record(s[Symbol.asyncDispose]===s.disposeAsync);",
    "expected": [
