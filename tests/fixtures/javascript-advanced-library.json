  {
    "name": "DisposableStack LIFO capture and callback receivers",
    "source": "var log=[],s=new DisposableStack(),resource={name:'resource',[Symbol.dispose](){log.push(this.name)}};record(s.use(resource)===resource);resource[Symbol.dispose]=function(){log.push('changed')};record(s.adopt(7,function(v){'use strict';log.push(v+':'+(this===undefined))}));record(s.defer(function(){'use strict';log.push('defer:'+(this===undefined))}));record(s.disposed);s.dispose();record(log.join('|'));record(s.disposed);record(s.dispose());record(s[Symbol.dispose]===s.dispose);record(Object.prototype.toString.call(s));",
    "expected": [
      "true",
      "7",
      "undefined",
      "false",
      "defer:true|7:true|resource",
      "true",
      "undefined",
      "true",
      "[object DisposableStack]"
    ]
  },
