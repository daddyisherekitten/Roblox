    "source": "var s=new AsyncDisposableStack();s.defer(function(){throw 'first'});s.defer(function(){return Promise.reject('second')});s.disposeAsync().catch(function(e){record(e instanceof SuppressedError);record(e.error);record(e.suppressed)});record('sync');AsyncDisposableStack.prototype.disposeAsync.call({}).catch(function(e){record(e.name)});",
    "expected": [
