    ],
    "browserOnly": true
  },
  {
    "name": "multi-property commit, one mutation, cancel retention",
    "source": "const box=document.getElementById('box');box.style.opacity='0.1';const observer=new MutationObserver(()=>{});observer.observe(box,{attributes:true,attributeOldValue:true});const a=box.animate({opacity:[0.2,0.7],backgroundColor:['red','blue'],transform:['translate(0px, 0px)','translate(50px, -10px)']},{duration:100,fill:'both'});a.pause();a.currentTime=50;a.commitStyles();record(box.style.opacity);record(box.style.backgroundColor);record(box.style.transform);const records=observer.takeRecords();record(records.length);record(records[0].attributeName);record(records[0].oldValue);record(a.playState);a.finished.catch(()=>{});a.ready.catch(()=>{});a.cancel();record(box.style.opacity);record(document.getAnimations().length);",
    "expected": [
      "0.45",
      "rgb(128, 0, 128)",
      "translate(25px, -5px)",
      "1",
      "style",
      "opacity: 0.1;",
      "paused",
      "0.45",
      "0"
    ],
    "paint": {
      "opacity": 0.45,
      "background": [
        128,
        0,
        128
      ],
      "x": 25,
      "y": -5
    }
  },
