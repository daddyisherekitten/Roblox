  {
    "name": "pending styles and rendered-target errors",
    "source": "const box=document.getElementById('box');const a=box.animate({opacity:[0,1]},100);a.pause();a.currentTime=50;box.style.visibility='hidden';a.commitStyles();record(box.style.opacity);box.style.visibility='visible';box.style.display='none';try{a.commitStyles()}catch(e){record(e.name)}box.style.display='block';document.getElementById('parent').style.display='none';try{a.commitStyles()}catch(e){record(e.name)}document.getElementById('parent').style.display='block';box.remove();try{a.commitStyles()}catch(e){record(e.name)}document.getElementById('parent').append(box);a.commitStyles();record(box.style.opacity);a.finished.catch(()=>{});a.ready.catch(()=>{});a.cancel();",
