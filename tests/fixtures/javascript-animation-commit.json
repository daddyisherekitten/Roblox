  {
    "name": "foreign namespace rejects before rendering check",
    "source": "const box=document.getElementById('box');const a=box.animate({opacity:[0,1]},100);a.pause();a.currentTime=50;a.effect.target=document.createElementNS('http://example.org/test','test');try{a.commitStyles()}catch(e){record(e.name)}a.finished.catch(()=>{});a.ready.catch(()=>{});a.cancel();",
