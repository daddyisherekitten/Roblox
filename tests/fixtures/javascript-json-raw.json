      "[null,-0,1E+400]",
      "123456789012345678901",
      "{\"x\":123456789012345678901}",
      "{}"
    ]
  },
  {
    "name": "replacer observes raw before direct insertion and may change it",
    "source": "const r=JSON.rawJSON('1e3'),log=[];record(JSON.stringify({x:r},function(k,v){log.push(k+':'+JSON.isRawJSON(v)+':'+arguments.length);return k==='x'?JSON.rawJSON('2e3'):v}));record(log.join(','));record(JSON.stringify(r,()=> 'quoted'));record(JSON.stringify(r,()=> undefined));record(JSON.stringify(r,(k,v)=>k===''?({rawJSON:'fake'}):v));",
    "expected": [
