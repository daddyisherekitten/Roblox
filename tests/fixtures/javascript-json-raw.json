    "source": "const text='{\"a\":9007199254740993,\"b\":12345678901234567890.1234500,\"c\":1E+400,\"d\":-0,\"arr\":[1e-400,2.300]}';const sources=[];const result=JSON.parse(text,function(k,v,ctx){if(typeof v==='number'){sources.push(ctx.source);return JSON.rawJSON(ctx.source)}return v});record(JSON.stringify(result)===text);record(sources.join('|'));record(JSON.stringify(result));",
