  {
    "name": "raw frozen shadow mutation strict delete and prototype invariants",
    "source": "const r=JSON.rawJSON('7');record(Reflect.set(r,'rawJSON','8'));record(Reflect.set(r,'extra',1));record(Reflect.deleteProperty(r,'rawJSON'));record(Reflect.defineProperty(r,'rawJSON',{value:'7'}));record(Reflect.defineProperty(r,'rawJSON',{value:'8'}));record(Reflect.defineProperty(r,'rawJSON',{get(){return '8'}}));record(Reflect.setPrototypeOf(r,{}));record(Reflect.setPrototypeOf(r,null));try{(()=>{'use strict';r.rawJSON='9'})()}catch(e){record(e.name)}try{(()=>{'use strict';delete r.rawJSON})()}catch(e){record(e.name)}record(JSON.stringify(r));",
    "expected": [
