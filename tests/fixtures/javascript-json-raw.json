  {
    "name": "JSON internal descriptors ignore Object prototype pollution",
    "source": "let gets=0;const getter=function(){gets++;throw 'poisoned-get'};Object.defineProperty(Object.prototype,'get',{get:getter,configurable:true});try{record(JSON.stringify(JSON.rawJSON('3')));const value=JSON.parse('{\"x\":1,\"a\":[2]}');record(value.x);record(value.a[0]);record(JSON.stringify(value));record(gets)}finally{delete Object.prototype.get}",
    "expected": [
