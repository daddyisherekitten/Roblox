  {
    "name": "isRawJSON proxy checks invoke no traps or revocation failures",
    "source": "const log=[];const p=new Proxy(JSON.rawJSON('1'),{get(){log.push('get');throw 'trap'},getPrototypeOf(){log.push('proto');throw 'trap'},ownKeys(){log.push('keys');throw 'trap'}});record(JSON.isRawJSON(p));record(log.length);const pair=Proxy.revocable(JSON.rawJSON('1'),{});pair.revoke();record(JSON.isRawJSON(pair.proxy));record(JSON.isRawJSON.call(null,JSON.rawJSON('2')));record(JSON.isRawJSON());",
    "expected": [
      "false",
      "0",
      "false",
      "true",
      "false"
    ]
  },
  {
    "name": "method metadata receiver independence and nonconstructor",
    "source": "for(const k of ['rawJSON','isRawJSON']){const f=JSON[k],d=Object.getOwnPropertyDescriptor(JSON,k);record(f.name+':'+f.length+':'+d.writable+':'+d.enumerable+':'+d.configurable);try{new f('1')}catch(e){record(e.name)}}record(JSON.rawJSON.call(null,'2').rawJSON);record(JSON.isRawJSON.call(3,JSON.rawJSON('3')));",
    "expected": [
      "rawJSON:1:true:false:true",
      "TypeError",
      "isRawJSON:1:true:false:true",
      "TypeError",
      "2",
      "true"
    ]
  },
  {
    "name": "stringify nested raws indentation replacement and arrays",
    "source": "const r=JSON.rawJSON('123456789012345678901');record(JSON.stringify({x:r,a:[r,JSON.rawJSON('true'),JSON.rawJSON('\"x\"'),undefined]},null,2));record(JSON.stringify([JSON.rawJSON('null'),JSON.rawJSON('-0'),JSON.rawJSON('1E+400')]));record(JSON.stringify(r,['rawJSON'],10));record(JSON.stringify({x:r},['x']));record(JSON.stringify({x:r},[]));",
    "expected": [
