    "source": "record(Object.prototype.toString.call(JSON));const d=Object.getOwnPropertyDescriptor(JSON,Symbol.toStringTag);record(d.value+':'+d.writable+':'+d.enumerable+':'+d.configurable);const r=JSON.rawJSON('1');record(Object.prototype.toString.call(r));record(Reflect.set(r,Symbol.toStringTag,'JSON'));record(JSON.isRawJSON({[Symbol.toStringTag]:'JSON',rawJSON:'1'}));record(JSON.isRawJSON({[Symbol.toStringTag]:'RawJSON',rawJSON:'1'}));",
