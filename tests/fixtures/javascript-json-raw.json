    "source": "const log=[];const key=new Number(2);key.toString=function(){log.push('number-key');return 'x'};record(JSON.stringify({x:JSON.rawJSON('1e3')},[key]));const space=new String('');space.toString=()=>{log.push('space-string');return '..'};record(JSON.stringify({x:JSON.rawJSON('2')},null,space));record(log.join(','));const b=new Boolean(false);b.valueOf=()=>{throw 'unused'};record(JSON.stringify(b));const r=JSON.rawJSON('3');record(JSON.stringify([r],(k,v)=>k==='0'?r.rawJSON:v));",
