      "{\"rawJSON\":\"fake\"}"
    ]
  },
  {
    "name": "toJSON before replacer and raw returned by hooks",
    "source": "const log=[];const o={get toJSON(){log.push('get-toJSON');return function(k){log.push('toJSON:'+k+':'+arguments.length+':'+(this===o));return JSON.rawJSON('9007199254740993')}}};record(JSON.stringify({x:o},function(k,v){log.push('replacer:'+k+':'+JSON.isRawJSON(v));return v}));record(log.join(','));",
    "expected": [
