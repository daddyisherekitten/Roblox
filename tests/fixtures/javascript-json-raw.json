    "source": "const r=JSON.rawJSON('123'),log=[];const p=new Proxy(r,{get(t,k,v){log.push('get:'+String(k));return Reflect.get(t,k,v)},ownKeys(t){log.push('keys');return Reflect.ownKeys(t)}});record(JSON.stringify(p));record(log.join(','));log.length=0;const q=new Proxy(r,{get(t,k,v){log.push('get:'+String(k));if(k==='toJSON')return ()=>r;return Reflect.get(t,k,v)},ownKeys(){throw 'unused'}});record(JSON.stringify(q));record(log.join(','));",
