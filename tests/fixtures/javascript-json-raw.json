    "source": "const r=JSON.rawJSON('123');record(Object.getPrototypeOf(r)===null);record(Object.isFrozen(r));record(Object.isSealed(r));record(Object.isExtensible(r));record(Object.getOwnPropertyNames(r).join(','));record(Object.getOwnPropertySymbols(r).length);record(JSON.stringify(Object.getOwnPropertyDescriptor(r,'rawJSON')));record(Object.prototype.toString.call(r));record(typeof r.toString);",
