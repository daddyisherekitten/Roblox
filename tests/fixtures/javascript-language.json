[
  {
    "name": "arrow lexical this and defaults",
    "source": "const o={x:7,f:function(){return (n=2)=>this.x+n;}}; const f=o.f();record(f.call({x:99},3));record(f());",
    "expected": [
      "10",
      "9"
    ]
  },
  {
    "name": "arrow implicit objects",
    "source": "const f=(x,y=3)=>({sum:x+y});record(f(4).sum);record(((x)=>x*2)(5));",
    "expected": [
      "7",
      "10"
    ]
  },
  {
    "name": "rest and parameters length",
    "source": "function f(a,b=2,...rest){record(f.length);return a+b+rest.length;}record(f(1,4,6,7));",
    "expected": [
      "1",
      "7"
    ]
  },
  {
    "name": "pattern parameters",
    "source": "function f({x=4},[a,,b=8],...r){record(x+a+b+r.length);}f({},[2],9,10);",
    "expected": [
      "16"
    ]
  },
  {
