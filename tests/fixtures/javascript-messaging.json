    "source": "const b=new Uint8Array([1,2,3]).buffer;const c=b.transfer(5);record(b.detached);record(new Uint8Array(c).join(\",\"));const d=c.transferToFixedLength(2);record(new Uint8Array(d).join(\",\"));try{structuredClone(b);}catch(e){record(e.name);}try{new Uint8Array(b);}catch(e){record(e.name);}",
