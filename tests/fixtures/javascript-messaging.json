    "source": "const c=new MessageChannel();const data={n:1};c.port2.onmessage=function(e){record(e.data.n);record(e.isTrusted);record(e.target===c.port2);record(e.ports.length);c.port1.close();c.port2.close();};c.port1.postMessage(data);data.n=9;Promise.resolve().then(function(){record(\"micro\");});record(\"sync\");",
