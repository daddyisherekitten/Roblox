  {
    "name": "FileList clones preserve repeated File identity with fresh target wrappers",
    "source": "const f=new File(['body'],'a.txt',{type:'text/plain',lastModified:123});const list=makeFileList([f]);const c=structuredClone({files:list,file:f,again:list});record(c.files instanceof FileList);record(c.files!==list);record(c.files===c.again);record(c.files[0]===c.file);record(c.file!==f);record(c.file.name);record(c.file.size);record(c.file.lastModified);record(Object.prototype.toString.call(c.files));",
    "expected": [
      "true",
      "true",
      "true",
      "true",
      "true",
      "a.txt",
      "4",
      "123",
      "[object FileList]"
    ],
    "browserExpected": [
      "true",
      "true",
      "true",
      "false",
      "true",
      "a.txt",
      "4",
      "123",
      "[object FileList]"
    ],
    "browserDifference": "Chromium FileList cloning creates a distinct File for the nested list entry; File API sub-serialization shares HTML structured-clone memory."
