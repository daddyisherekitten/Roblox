[
  {
    "name": "MessageEvent dictionary conversion visits getters once in order",
    "group": "messaging",
    "source": "const order=[];const init={};for(const key of ['source','ports','origin','lastEventId','data','composed','cancelable','bubbles'])Object.defineProperty(init,key,{get:function(){order.push(key);return undefined;}});const e=new MessageEvent('message',init);record(order.join(','));record(e.data===null);",
    "expected": [
      "bubbles,cancelable,composed,data,lastEventId,origin,ports,source",
      "true"
    ]
  },
  {
    "name": "ErrorEvent defaults inheritance and readonly fields",
    "group": "messaging",
    "source": "const reason={x:1};const e=new ErrorEvent('error',{message:'bad',filename:'task.js',lineno:3,colno:4,error:reason});record(e instanceof Event);record(e.message);record(e.filename);record(e.lineno);record(e.colno);record(e.error===reason);e.message='ignored';record(e.message);record(new ErrorEvent('error').error===undefined);",
    "expected": [
      "true",
      "bad",
      "task.js",
      "3",
      "4",
      "true",
      "bad",
      "true"
    ]
  },
  {
    "name": "Clone cycles shared identity holes and primitive values",
    "group": "messaging",
    "source": "const shared={n:2};const a={left:shared,right:shared};a.self=a;a.holes=[,3,,];const b=structuredClone(a);record(b!==a);record(b.self===b);record(b.left===b.right);record(b.left!==shared);record(b.holes.length);record(0 in b.holes);record(1 in b.holes);record(2 in b.holes);record(Object.is(structuredClone(-0),-0));record(Number.isNaN(structuredClone(NaN)));",
    "expected": [
      "true",
      "true",
      "true",
      "true",
      "3",
      "false",
      "true",
      "false",
      "true",
      "true"
    ]
  },
  {
    "name": "Clone flattens getters and custom prototypes",
    "group": "messaging",
    "source": "let calls=0;const a=Object.create({inherited:1});Object.defineProperty(a,\"x\",{get:function(){calls++;return 7;},enumerable:true});Object.defineProperty(a,\"hidden\",{value:2});a[Symbol(\"s\")]=3;const b=structuredClone(a);record(calls);record(b.x);record(b.inherited===undefined);record(b.hidden===undefined);record(Object.getOwnPropertySymbols(b).length);const d=Object.getOwnPropertyDescriptor(b,\"x\");record(d.writable&&d.enumerable&&d.configurable);record(Object.getPrototypeOf(b)===Object.prototype);",
    "expected": [
      "1",
      "7",
      "true",
      "true",
      "0",
      "true",
      "true"
    ]
  },
  {
    "name": "Clone Map Set Date boxed primitives and cycles",
    "group": "messaging",
    "source": "const key={x:1};const map=new Map([[key,key]]);const set=new Set([key,map]);map.set(\"self\",map);const b=structuredClone({map:map,set:set,key:key,date:new Date(1234),boxed:new Number(7)});record(b.map.get(b.key)===b.key);record(b.map.get(\"self\")===b.map);record(b.set.has(b.key));record(b.set.has(b.map));record(b.date.getTime());record(b.boxed.valueOf());",
    "expected": [
      "true",
      "true",
      "true",
      "true",
      "1234",
      "7"
    ]
  },
  {
    "name": "Clone snapshots map entries before key getters mutate source",
    "group": "messaging",
    "source": "const map=new Map();const key={};Object.defineProperty(key,\"x\",{enumerable:true,get:function(){map.set(\"later\",3);return 1;}});map.set(key,2);const copy=structuredClone(map);record(copy.size);record(map.size);",
    "expected": [
      "1",
      "2"
    ]
  },
  {
    "name": "Clone Error cause cycles and DOMException",
    "group": "messaging",
    "source": "const e=new TypeError(\"bad\",{cause:{code:3}});e.cause.error=e;const c=structuredClone(e);record(c instanceof TypeError);record(c.message);record(c.cause.code);record(c.cause.error===c);const d=structuredClone(new DOMException(\"stop\",\"AbortError\"));record(d.name);record(d.message);record(d.code);",
