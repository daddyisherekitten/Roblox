  {
    "name": "Clone binary aliasing without detach",
    "group": "messaging",
    "source": "const buffer=new ArrayBuffer(8);const u=new Uint8Array(buffer,2,3);u.set([1,2,3]);const d=new DataView(buffer,1,5);const c=structuredClone({buffer:buffer,u:u,d:d});record(c.buffer!==buffer);record(c.u.buffer===c.buffer);record(c.d.buffer===c.buffer);record(c.u.byteOffset);record(c.d.byteLength);record(c.u.join(\",\"));c.u[0]=9;record(u[0]);",
    "expected": [
      "true",
      "true",
      "true",
      "2",
      "5",
      "1,2,3",
      "1"
    ]
  },
  {
    "name": "Clone transfer detaches source buffer and views",
    "group": "messaging",
    "source": "const buffer=new ArrayBuffer(4);const u=new Uint8Array(buffer);u.set([1,2,3,4]);const d=new DataView(buffer);const c=structuredClone({buffer:buffer,u:u},{transfer:[buffer]});record(buffer.byteLength);record(buffer.detached);record(u.length);record(u.byteOffset);record(u[0]===undefined);record(c.u.buffer===c.buffer);record(c.u.join(\",\"));try{u.slice();}catch(e){record(e.name);}try{record(d.byteLength);}catch(e){record(e.name);}",
    "expected": [
      "0",
      "true",
      "0",
      "0",
      "true",
      "true",
      "1,2,3,4",
      "TypeError",
      "TypeError"
    ]
  },
  {
    "name": "Transfer failure is atomic for other ArrayBuffers",
    "group": "messaging",
    "source": "const b=new ArrayBuffer(4);try{structuredClone({f:function(){}},{transfer:[b]});}catch(e){record(e.name);}record(b.byteLength);try{structuredClone({}, {transfer:[b,b]});}catch(e){record(e.name);}record(b.byteLength);try{structuredClone({}, {transfer:[new Uint8Array(1)]});}catch(e){record(e.name);}",
    "expected": [
      "DataCloneError",
      "4",
      "DataCloneError",
      "4",
      "DataCloneError"
    ]
  },
  {
    "name": "Transferred buffer bytes reflect getter side effects",
    "group": "messaging",
    "source": "const b=new ArrayBuffer(1);const view=new Uint8Array(b);view[0]=1;const source={buffer:b};Object.defineProperty(source,\"after\",{enumerable:true,get:function(){view[0]=9;return 2;}});const copy=structuredClone(source,{transfer:[b]});record(new Uint8Array(copy.buffer)[0]);record(b.byteLength);",
    "expected": [
      "9",
      "0"
    ]
  },
