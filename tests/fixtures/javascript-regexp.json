      "SyntaxError",
      "SyntaxError",
      "SyntaxError",
      "SyntaxError",
      "SyntaxError",
      "SyntaxError",
      "SyntaxError"
    ]
  },
  {
    "name": "Legacy decimal escapes and escaped sources",
    "source": "record(new RegExp('\\\\1').test('\\x01'));record(new RegExp('\\\\8').test('8'));record(new RegExp('[\\\\0]').test('\\0'));record(new RegExp('\\\\n').source);record(new RegExp('[a/b]').source);",
    "expected": [
