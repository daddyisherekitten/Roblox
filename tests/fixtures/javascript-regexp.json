  {
    "name": "ASI before declaration and restricted statement regex goals",
    "source": "var n=1\nfunction f(){} /x/.test('x')&&record('declaration');while(false){break\n/x/.test('x');}label:while(false){break label\n/x/.test('x');}record(4/2);",
    "expected": [
      "declaration",
      "2"
    ]
  }
