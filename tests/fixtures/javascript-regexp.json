      "SyntaxError",
      "SyntaxError",
      "SyntaxError"
    ]
  },
  {
    "name": "RegExp literals division and fresh literal evaluation",
    "source": "const r=/a[\\/]b/gi;record(r.source);record(r.flags);record(r.test('A/b'));record(12/3/2);record(({x:6}).x/2);function make(){return /a/g;}record(make()!==make());if(true)/x/.test('x')&&record('control');record((function(){return 8;})()/2);",
    "expected": [
      "a[\\/]b",
      "gi",
      "true",
      "2",
      "3",
      "true",
      "control",
      "4"
    ]
  },
  {
    "name": "Unicode lastIndex inside surrogate pair",
    "source": "const r=new RegExp('.','uy');r.lastIndex=1;const m=r.exec('😀');record(m&&m.index);record(m&&m[0]);record(r.lastIndex);",
    "expected": [
      "0",
      "😀",
      "2"
    ]
