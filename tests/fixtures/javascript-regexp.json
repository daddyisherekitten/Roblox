    ]
  },
  {
    "name": "Readonly lastIndex throws only when execution changes it",
    "source": "const a=new RegExp('a');Object.defineProperty(a,'lastIndex',{writable:false});record(a.test('a'));const g=new RegExp('a','g');Object.defineProperty(g,'lastIndex',{writable:false});try{g.test('a');}catch(e){record(e.name);}try{g.test('z');}catch(e){record(e.name);}",
    "expected": [
      "true",
      "TypeError",
      "TypeError"
    ]
  },
  {
    "name": "Duplicate names in disjoint alternatives and named backreferences",
    "source": "const r=new RegExp('(?:(?<x>a)|(?<x>b))\\\\k<x>','d');record(r.exec('bb').groups.x);record(r.exec('aa').indices.groups.x.join(','));try{new RegExp('(?<x>a)(?<x>b)');}catch(e){record(e.name);}",
    "expected": [
      "b",
      "0,1",
      "SyntaxError"
    ]
  },
  {
    "name": "Unicode string properties and invalid complements",
    "source": "record(new RegExp('\\\\p{RGI_Emoji}','v').exec('x👩‍💻y')[0]);record(new RegExp('\\\\p{RGI_Emoji_Flag_Sequence}','v').test('🇩🇪'));record(new RegExp('\\\\p{Basic_Emoji}','v').test('😀'));for(const p of ['[a-z--[aeiou]]','[^\\\\q{ab}]','\\\\P{RGI_Emoji}']){try{new RegExp(p,'v');}catch(e){record(e.name);}}",
    "expected": [
