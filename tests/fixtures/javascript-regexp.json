  {
    "name": "Legacy compile updates source flags and index",
    "source": "const r=/a/g;r.lastIndex=2;record(r.compile(/b/i)===r);record(r.source);record(r.flags);record(r.lastIndex);record(r.test('B'));try{r.compile(/x/,'g');}catch(e){record(e.name);}",
    "expected": [
      "true",
      "b",
      "i",
      "0",
      "true",
      "TypeError"
    ]
