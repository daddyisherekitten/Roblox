  "css": "* { box-sizing: border-box; }\nbody { margin: 0; background: #f6f5f0; color: #223c34; font-family: Arial, sans-serif; font-size: 15px; line-height: 1.5; }\na { color: #24483b; text-underline-offset: 4px; }\n.topbar { max-width: 1160px; margin: 0 auto; padding: 18px 24px; display: flex; justify-content: space-between; gap: 20px; border-bottom: 1px solid #cfd8cd; }\nmain { max-width: 1160px; margin: 0 auto; padding: 0 24px; }\n.intro { padding: 26px 0 24px; }\n.eyebrow { margin: 0 0 10px; font-size: 11px; font-weight: 700; letter-spacing: 1.8px; text-transform: uppercase; color: #7d543c; }\nh1 { margin: 0 0 12px; font-size: 42px; line-height: 1.1; letter-spacing: -1px; }\nh2 { margin: 0 0 12px; font-size: 23px; line-height: 1.2; }\np { margin: 0 0 14px; }\n.lead { font-size: 17px; max-width: 760px; }\n.status { display: inline-block; margin-bottom: 16px; padding: 8px 12px; background: #e1ead9; border: 1px solid #bdcfb4; }\n.jump { display: flex; flex-wrap: wrap; gap: 8px 18px; }\n.jump a { font-size: 13px; }\n.tests { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }\n.test { min-width: 0; padding: 22px; border: 1px solid #cad3c7; background: #fff; scroll-margin-top: 18px; }\n.traversal-sample { display: flex; flex-wrap: wrap; gap: 10px; padding: 12px; background: #edf1e8; }\n.traversal-sample > div { border: 1px dashed #9bac9d; padding: 0 6px; }\n.matrix-scene { position: relative; width: 230px; max-width: 100%; height: 84px; background: #edf1e8; overflow: hidden; }\n.matrix-origin { position: absolute; left: 15px; top: 15px; width: 16px; height: 16px; border: 1px dashed #7d543c; }\n.matrix-dot { position: absolute; left: 0; top: 0; width: 16px; height: 16px; background: #24483b; color: white; font-size: 11px; line-height: 16px; text-align: center; }\n.actions { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0; }\nbutton { display: inline-block; padding: 9px 12px; background: #24483b; color: #fff; border: 1px solid #24483b; font: inherit; cursor: pointer; }\nbutton:hover { background: #376353; }\nbutton.secondary { color: #24483b; background: #f5f6f0; }\nbutton:focus-visible, input:focus-visible { outline: 2px solid #b6643e; outline-offset: 3px; }\nlabel { display: block; margin: 0 0 6px; font-weight: 700; }\ninput[type=\"text\"] { display: block; width: 100%; min-width: 0; padding: 9px 10px; margin: 0 0 12px; border: 1px solid #9bac9d; color: #223c34; background: #fff; font: inherit; }\n.check { display: block; font-weight: 400; margin: 10px 0; }\ninput[type=\"checkbox\"] { accent-color: #24483b; margin-right: 6px; }\n.result { padding: 12px; margin: 0; background: #eef2e7; border-left: 3px solid #9bad8f; overflow-wrap: anywhere; white-space: pre-line; }\n.hint { color: #627269; font-size: 13px; margin: 12px 0 0; }\n.notes { margin: 12px 0; padding-left: 24px; }\n.note { padding: 12px; margin: 0 0 10px; background: #eef2e7; border: 1px solid #cad3c7; }\n.note strong { display: block; margin-bottom: 6px; }\n.measure { width: 120px; height: 44px; background: #e7b885; border: 2px solid #9b633f; text-align: center; padding: 7px 0; }\n.track { height: 54px; padding: 7px 10px; background: #edf1e8; border: 1px solid #d2dbcc; overflow: hidden; }\n.animation-box { width: 38px; height: 38px; background: #24483b; }\ncanvas { display: block; width: 260px; max-width: 100%; height: auto; margin: 12px 0; }\nfooter { padding: 24px 0 30px; color: #667468; font-size: 13px; }\n@media (max-width: 720px) { .tests { grid-template-columns: 1fr; } h1 { font-size: 34px; } .test { padding: 18px; } }\n@media (max-width: 400px) { main, .topbar { padding-left: 14px; padding-right: 14px; } .topbar { font-size: 13px; } }\n"
