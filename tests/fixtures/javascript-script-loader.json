    "resources": {},
    "expected": [
      "active",
      "dcl interactive",
      "load complete"
    ]
  },
  {
    "name": "HTML import map and inline module document URL",
    "html": "<script type='importmap'>{\"imports\":{\"thing\":\"./thing.js\"}}</script><script type='module'>import {value} from 'thing';console.log(value,import.meta.url===document.URL);</script>",
    "resources": {
      "https://scripts.test/thing.js": {
        "Source": "export const value=42;",
        "Delay": 2
      }
    },
    "expected": [
      "42 true",
      "dcl interactive",
      "load complete"
    ]
  },
  {
    "name": "JSON import attribute with realm caching",
    "html": "<script type='module'>import value from './data.json' with {type:'json'};await new Promise(r=>setTimeout(r,10));const other=await import('./data.json',{with:{type:'json'}});console.log(value.name,value===other.default);</script>",
    "resources": {
      "https://scripts.test/data.json": {
        "Source": "{\"name\":\"shared\"}",
        "MIME": "application/json",
        "Delay": 2
      }
    },
    "expected": [
      "dcl interactive",
      "load complete",
      "shared true"
    ]
  },
  {
    "name": "dynamic inline executes synchronously once",
    "html": "<script>console.log('before');var s=document.createElement('script');s.id='dynamic';s.text='console.log(\"dynamic\",document.currentScript.id)';document.body.append(s);console.log('after');s.remove();document.body.append(s);document.body.append(s.cloneNode(true));</script>",
    "resources": {},
    "expected": [
      "before",
      "dynamic dynamic",
      "after",
      "dcl interactive",
      "load complete"
    ]
  },
  {
    "name": "nested scripts retain outer currentScript and checkpoint",
    "html": "<script>var outer=document.currentScript;var s=document.createElement('script');s.text='console.log(\"inner\");queueMicrotask(()=>console.log(\"micro\",document.currentScript===null))';document.body.append(s);console.log('outer',document.currentScript===outer);</script>",
    "resources": {},
    "expected": [
      "inner",
      "outer true",
      "micro false",
      "dcl interactive",
      "load complete"
    ]
  },
  {
    "name": "atomic insertion lets earlier script remove later one",
    "html": "<script>var a=document.createElement('script'),b=document.createElement('script');b.id='later';a.text='document.getElementById(\"later\").remove();console.log(\"first\")';b.text='console.log(\"bad\")';document.body.append(a,b);</script>",
    "resources": {},
    "expected": [
      "first",
      "dcl interactive",
      "load complete"
    ]
  },
  {
    "name": "empty connected script runs after text property write",
    "html": "<script>var s=document.createElement('script');document.body.append(s);console.log('empty');s.text='console.log(\"filled\")';s.text='console.log(\"bad repeat\")';</script>",
    "resources": {},
    "expected": [
      "empty",
      "filled",
      "dcl interactive",
      "load complete"
    ]
  },
  {
    "name": "dynamic default async finishes in load order",
    "html": "<script>var a=document.createElement('script'),b=document.createElement('script');console.log(a.async,a.hasAttribute('async'));a.src='./slow.js';b.src='./fast.js';document.body.append(a,b);console.log('inserted');</script>",
    "resources": {
      "https://scripts.test/slow.js": {
        "Source": "console.log(\"slow\")",
        "Delay": 20
      },
      "https://scripts.test/fast.js": {
        "Source": "console.log(\"fast\")",
        "Delay": 2
      }
    },
    "expected": [
      "true false",
      "inserted",
      "dcl interactive",
      "fast",
      "slow",
      "load complete"
    ]
  },
  {
    "name": "dynamic async false preserves insertion order",
    "html": "<script>var a=document.createElement('script'),b=document.createElement('script');a.async=false;b.async=false;a.src='./slow.js';b.src='./fast.js';document.body.append(a,b);console.log(a.async,a.hasAttribute('async'));</script>",
    "resources": {
      "https://scripts.test/slow.js": {
        "Source": "console.log(\"slow\")",
        "Delay": 20
      },
      "https://scripts.test/fast.js": {
        "Source": "console.log(\"fast\")",
        "Delay": 2
      }
    },
    "expected": [
      "false false",
      "dcl interactive",
      "slow",
      "fast",
      "load complete"
    ]
  },
  {
    "name": "src added after connection prepares script",
    "html": "<script>var s=document.createElement('script');s.onload=()=>console.log('element load');document.body.append(s);s.src='./added.js';console.log('url',s.src.endsWith('/added.js'));</script>",
