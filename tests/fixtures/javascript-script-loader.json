[
  {
    "name": "classic inline checkpoints and currentScript",
    "html": "<script id='one'>console.log('one',document.currentScript.id);queueMicrotask(()=>console.log('micro',document.currentScript===null));</script><script>console.log('two');</script>",
    "resources": {},
    "expected": [
      "one one",
      "micro false",
      "two",
      "dcl interactive",
      "load complete"
    ]
  },
  {
    "name": "blocking external script ordering",
    "html": "<script>console.log('before');</script><script id='external' src='./external.js'></script><script>console.log('after');</script>",
    "resources": {
      "https://scripts.test/external.js": {
        "Source": "console.log('external',document.currentScript.id);queueMicrotask(()=>console.log('external micro'));",
        "Delay": 5
      }
    },
    "expected": [
      "before",
      "external external",
      "external micro",
      "after",
      "dcl interactive",
      "load complete"
    ]
  },
  {
    "name": "defer order survives opposite load completion",
    "html": "<script defer src='./a.js'></script><script defer src='./b.js'></script><script>console.log('inline');</script>",
    "resources": {
      "https://scripts.test/a.js": {
        "Source": "console.log('a',document.readyState);queueMicrotask(()=>console.log('a micro'));",
        "Delay": 20
      },
      "https://scripts.test/b.js": {
        "Source": "console.log('b',document.readyState);",
        "Delay": 2
      }
    },
    "expected": [
      "inline",
      "a interactive",
      "a micro",
      "b interactive",
      "dcl interactive",
      "load complete"
    ]
  },
  {
    "name": "async executes during blocking load",
    "html": "<script async src='./async.js'></script><script src='./blocking.js'></script><script>console.log('after blocking');</script>",
    "resources": {
      "https://scripts.test/async.js": {
        "Source": "console.log('async',document.readyState);",
        "Delay": 2
      },
      "https://scripts.test/blocking.js": {
        "Source": "console.log('blocking');",
        "Delay": 20
      }
    },
    "expected": [
      "async loading",
      "blocking",
      "after blocking",
      "dcl interactive",
      "load complete"
    ]
  },
  {
    "name": "async does not delay DOMContentLoaded",
    "html": "<script async src='./async.js'></script><script>console.log('inline');</script>",
    "resources": {
      "https://scripts.test/async.js": {
        "Source": "console.log('async',document.readyState);",
        "Delay": 20
      }
    },
    "expected": [
      "inline",
      "dcl interactive",
      "async interactive",
      "load complete"
    ]
  },
  {
    "name": "inline module top-level await does not delay document events",
    "html": "<script type='module'>console.log('module',document.currentScript===null);await new Promise(r=>setTimeout(r,40));console.log('module end');</script><script>console.log('inline');</script>",
    "resources": {},
    "expected": [
      "inline",
      "module true",
      "dcl interactive",
      "load complete",
      "module end"
    ]
  },
  {
    "name": "defer after awaited module starts before module settles",
    "html": "<script type='module' src='./module.js'></script><script defer src='./defer.js'></script>",
    "resources": {
      "https://scripts.test/module.js": {
        "Source": "console.log('module');await new Promise(r=>setTimeout(r,40));console.log('module end');",
        "Delay": 2
      },
      "https://scripts.test/defer.js": {
        "Source": "console.log('defer');",
        "Delay": 3
      }
    },
    "expected": [
      "module",
      "defer",
      "dcl interactive",
      "load complete",
      "module end"
    ]
  },
  {
    "name": "inert data template and nomodule scripts",
