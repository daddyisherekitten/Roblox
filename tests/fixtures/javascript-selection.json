    "source": "document.body.innerHTML='<div id=p>A   <b>B</b><br>C<p>D</p>E<span style=\"display:none\">hidden</span></div>';getSelection().selectAllChildren(document.getElementById('p'));record(JSON.stringify(String(getSelection())));",
    "expected": [
