  },
  {
    "name": "directionless range extension uses normative endpoints",
    "source": "document.body.innerHTML='<p id=p>abcdef</p>';const t=document.getElementById('p').firstChild,s=getSelection();s.collapse(t,1);s.getRangeAt(0).setEnd(t,4);record([s.anchorOffset,s.focusOffset,s.direction,String(s)].join('|'));",
    "expected": [
      "4|1|none|bcd"
    ],
    "browserExpected": [
      "1|4|forward|bcd"
    ],
    "difference": "A script mutation preserves directionless under the Selection API, whose anchor is end unless forward; Chromium resets it to forward."
  },
  {
    "name": "shadowRoot sequence rejects without iterator close",
    "source": "const log=[],roots={[Symbol.iterator](){return {next(){return {value:{},done:false}},return(){log.push('close');return {done:true}}}}};try{getSelection().getComposedRanges({shadowRoots:roots})}catch(e){log.push(e.name)}record(log.join(','));",
    "expected": [
      "TypeError"
    ]
  },
  {
    "name": "sequence rejects primitive before iterator lookup",
    "source": "const log=[],key=Symbol.iterator,old=Object.getOwnPropertyDescriptor(String.prototype,key);Object.defineProperty(String.prototype,key,{get(){log.push('get');return old.value},configurable:true});try{getSelection().getComposedRanges({shadowRoots:'x'})}catch(e){log.push(e.name)}Object.defineProperty(String.prototype,key,old);record(log.join(','));",
    "expected": [
