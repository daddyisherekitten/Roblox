    "browserOnly": true,
    "source": "document.body.innerHTML='<p id=p style=\"text-transform:uppercase\">aßb</p><p id=q style=\"white-space:pre-wrap\"></p>';const t=document.getElementById('p').firstChild,s=getSelection();s.setBaseAndExtent(t,1,t,2);record(String(s));const q=document.getElementById('q');q.textContent='A\\r\\nB';s.selectAllChildren(q);record(JSON.stringify(String(s)));",
