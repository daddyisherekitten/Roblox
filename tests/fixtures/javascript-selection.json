    "source": "document.body.innerHTML='<p id=p style=\"width:30px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap\">abcdef ghijkl</p>';const r=document.createRange();r.selectNodeContents(document.getElementById('p'));getSelection().addRange(r);record(String(getSelection()));",
