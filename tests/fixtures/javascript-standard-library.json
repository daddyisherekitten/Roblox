    "source": "var p=Object.create(Array.prototype);Object.defineProperty(p,'0',{get:function(){return 7;},configurable:true});var a=new Array(3);a[1]=2;a[2]=3;Object.setPrototypeOf(a,p);var seen=[];var m=a.map(function(v,i){seen.push(v);if(i===0){delete a[2];}return v*2;});record(seen.join(','));record(m.join('|'));record(Object.keys(m).join(','));",
