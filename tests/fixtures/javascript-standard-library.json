  {
    "name": "JSON reviver this and mutations",
    "source": "var parents=[];var o=JSON.parse('{\"a\":1,\"b\":2}',function(k,v){if(k==='a'){this.b=4;}if(k==='b'){parents.push(this.a);return v*2;}return v;});record(JSON.stringify(o));record(parents.join(','));var src=[];JSON.parse('[9007199254740993,true,null]',function(k,v,context){if(k!==''){src.push(context.source);}return v;});record(src.join('|'));",
