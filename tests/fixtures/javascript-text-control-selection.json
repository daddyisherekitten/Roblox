  {
    "name": "webidl conversion order receiver and overload errors",
    "source": "const i=document.createElement('input'),b=document.createElement('input'),t=document.createElement('textarea');i.defaultValue='abcdef';b.defaultValue='abcdef';const order=[];i.setSelectionRange({valueOf(){order.push('start');return 1}},{valueOf(){order.push('end');return 4}},{toString(){order.push('direction');return 'backward'}});record(order.join(','));b.setSelectionRange.call(i,2,3,'forward');record(i.selectionStart+':'+i.selectionEnd);for(const fn of [()=>i.setSelectionRange.call(t,0,1),()=>i.setSelectionRange(),()=>i.setRangeText(),()=>i.setRangeText('X',1),()=>i.setRangeText('X',0,1,'bad'),()=>i.setSelectionRange(Symbol(),1),()=>i.setSelectionRange(1n,1)]){try{fn()}catch(e){record(e.name)}}record(i.setSelectionRange===i.setSelectionRange);record(i.setSelectionRange.length);record(i.setRangeText.length);record(i.select.name)",
    "expected": [
      "start,end,direction",
      "2:3",
      "TypeError",
      "TypeError",
      "TypeError",
      "TypeError",
      "TypeError",
      "TypeError",
      "TypeError",
      "true",
      "2",
      "1",
      "select"
    ]
  },
  {
    "name": "invalid range dirties value but failed webidl conversion does not",
    "source": "const i=document.createElement('input');i.defaultValue='abcdef';try{i.setRangeText('X',4,2)}catch(e){record(e.name)}i.defaultValue='changed';record(i.value);const j=document.createElement('input');j.defaultValue='abcdef';try{j.setRangeText('X',0,1,'invalid')}catch(e){record(e.name)}j.defaultValue='changed';record(j.value);const k=document.createElement('input');k.defaultValue='abcdef';k.setRangeText('X',99,100,'end');record(k.value+':'+k.selectionStart)",
    "expected": [
      "IndexSizeError",
      "abcdef",
      "TypeError",
      "changed",
      "abcdefX:7"
    ],
    "browserExpected": [
      "IndexSizeError",
      "changed",
      "TypeError",
      "changed",
      "X:1"
    ],
    "difference": "The reference browser leaves a failed range clean and omits unaccessed default text when replacing at out-of-range offsets. HTML sets the dirty value flag before the IndexSizeError check and uses the current relevant value; this profile follows those steps."
  },
  {
    "name": "asynchronous select and coalesced element selectionchange",
    "async": true,
    "source": "const i=document.createElement('input');i.defaultValue='abcdef';document.body.appendChild(i);let selects=0,changes=0,documentChanges=0,inputs=0,flags=true,done;const settled=new Promise(resolve=>done=resolve);function checkpoint(){if(selects===3&&changes===1)done()}i.addEventListener('select',e=>{selects++;flags=flags&&e.bubbles&&!e.cancelable;checkpoint()});i.addEventListener('selectionchange',e=>{changes++;flags=flags&&e.bubbles&&!e.cancelable;checkpoint()});document.addEventListener('selectionchange',e=>{if(e.target===i)documentChanges++});i.addEventListener('input',()=>inputs++);i.setSelectionRange(1,4);i.selectionDirection='backward';i.setSelectionRange(1,4,'backward');i.selectionStart=2;record(selects+':'+changes);await Promise.resolve();record(selects+':'+changes);await Promise.race([settled,new Promise(resolve=>setTimeout(resolve,500))]);record(selects+':'+changes+':'+documentChanges+':'+inputs);record(flags)",
    "expected": [
      "0:0",
      "0:0",
      "3:1:1:0",
      "true"
    ]
  },
  {
    "name": "select supports email and number text UI without exposing range APIs",
    "async": true,
    "source": "let count=0,done;const settled=new Promise(resolve=>done=resolve);for(const kind of ['email','number']){const i=document.createElement('input');i.type=kind;i.value=kind==='email'?'a@example.test':'123';document.body.appendChild(i);i.addEventListener('select',()=>{count++;if(count===2)done()});i.select();record(kind+':'+i.selectionStart+':'+i.selectionEnd+':'+i.selectionDirection);try{i.setSelectionRange(0,1)}catch(e){record(e.name)}}await Promise.race([settled,new Promise(resolve=>setTimeout(resolve,500))]);record(count)",
    "expected": [
      "email:null:null:null",
      "InvalidStateError",
      "number:null:null:null",
      "InvalidStateError",
      "2"
    ]
  },
  {
    "name": "selection state remains detached and disabled",
    "source": "const i=document.createElement('input');i.value='abcdef';document.body.appendChild(i);i.setSelectionRange(1,5,'backward');i.remove();record(i.selectionStart+':'+i.selectionEnd+':'+i.selectionDirection);i.disabled=true;i.readOnly=true;i.setSelectionRange(2,4,'forward');i.setRangeText('X',2,4,'select');record(i.value+':'+i.selectionStart+':'+i.selectionEnd);document.body.appendChild(i);record(i.selectionStart+':'+i.selectionEnd+':'+i.selectionDirection)",
    "expected": [
      "1:5:backward",
      "abXef:2:3",
      "2:3:none"
    ],
    "browserExpected": [
      "1:5:backward",
      "abXef:2:3",
      "2:3:forward"
    ],
    "difference": "The reference browser uses forward as its platform default for the reset direction; this profile supports none."
  },
  {
    "name": "textarea readonly textlength and clean defaults",
    "source": "const t=document.createElement('textarea');t.defaultValue='abcdef';t.setSelectionRange(1,5,'backward');t.defaultValue='abc';record(t.value+':'+t.selectionStart+':'+t.selectionEnd+':'+t.selectionDirection);t.textLength=100;record(t.textLength);try{(()=>{'use strict';t.textLength=100})()}catch(e){record(e.name)}const i=document.createElement('input');record(i.textLength===undefined);i.textLength=100;record(i.textLength)",
    "expected": [
      "abc:1:3:backward",
      "3",
      "TypeError",
      "true",
      "100"
    ],
    "browserExpected": [
      "abc:0:0:forward",
      "3",
      "TypeError",
      "true",
      "100"
    ],
    "difference": "The reference browser resets a clean textarea selection to zero when its default text changes. HTML children-changed steps set the raw value and generic relevant-value steps clamp the previous selection; this profile preserves and clamps it."
  },
  {
    "name": "normalized same value preserves selection",
    "source": "const t=document.createElement('textarea');t.value='A\\r\\nB';t.setSelectionRange(0,2,'backward');t.value='A\\nB';record(t.selectionStart+':'+t.selectionEnd+':'+t.selectionDirection);const i=document.createElement('input');i.value='A\\r\\nB';i.setSelectionRange(0,1,'forward');i.value='AB';record(i.selectionStart+':'+i.selectionEnd+':'+i.selectionDirection);const u=document.createElement('input');u.type='url';u.value='  abc  ';u.setSelectionRange(1,2,'backward');u.value='\\t abc \\n';record(u.value+':'+u.selectionStart+':'+u.selectionEnd+':'+u.selectionDirection)",
    "expected": [
      "0:2:backward",
      "0:1:forward",
      "abc:1:2:backward"
    ]
  },
  {
    "name": "DOMException brands and conversion before invalid state",
    "source": "const i=document.createElement('input');i.type='email';for(const fn of [()=>i.setSelectionRange(0,1),()=>i.setRangeText('x'),()=>{i.selectionEnd=1}]){try{fn()}catch(e){record(e instanceof DOMException);record(e.name);record(e.code)}}try{i.selectionEnd=Symbol()}catch(e){record(e instanceof TypeError)}const t=document.createElement('textarea');t.value='abcd';try{t.setRangeText('x',3,1)}catch(e){record(e instanceof DOMException);record(e.name);record(e.code)}",
    "expected": [
