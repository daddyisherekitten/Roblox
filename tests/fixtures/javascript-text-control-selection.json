    "difference": "The reference browser uses the platform default forward direction. This Windows/native-editor profile supports none; HTML permits both platform defaults."
  },
  {
    "name": "clamping nullable setters and direction",
    "source": "const i=document.createElement('input');i.defaultValue='abcdef';const state=()=>record(i.selectionStart+':'+i.selectionEnd+':'+i.selectionDirection);i.setSelectionRange(2,5,'backward');i.selectionStart=4;state();i.selectionEnd=3;state();i.selectionStart=99;state();i.setSelectionRange(4,2,'forward');state();i.setSelectionRange(-1,3);state();i.selectionStart=null;state();i.selectionEnd=undefined;state();i.selectionDirection='BACKWARD';state();i.selectionDirection={toString(){return 'forward'}};state();i.selectionDirection=null;state()",
    "expected": [
      "4:5:backward",
      "3:3:backward",
      "6:6:backward",
      "2:2:forward",
      "3:3:none",
      "0:3:none",
      "0:0:none",
      "0:0:none",
      "0:0:forward",
      "0:0:none"
    ],
    "browserExpected": [
      "4:5:backward",
      "3:3:backward",
      "6:6:backward",
      "2:2:forward",
      "3:3:forward",
      "0:3:forward",
      "0:0:forward",
      "0:0:forward",
      "0:0:forward",
      "0:0:forward"
    ],
    "difference": "The reference browser uses the platform default forward direction when the algorithm requests none; this profile supports none as permitted by HTML."
  },
  {
    "name": "utf16 replacement and textarea normalized newlines",
    "source": "const i=document.createElement('input');i.value='ab😀cd';i.setSelectionRange(2,3);record(i.value.slice(i.selectionStart,i.selectionEnd).charCodeAt(0));i.setRangeText('X',2,3,'select');record(i.value.length);record(i.value.charCodeAt(3));record(i.selectionStart+':'+i.selectionEnd);const t=document.createElement('textarea');t.value='A\\r\\nB\\rC';record(t.value.length);record(t.textLength);t.setRangeText('replaced',0,2,'end');record(t.value);record(t.selectionStart+':'+t.selectionEnd)",
    "expected": [
      "55357",
      "6",
      "56832",
      "2:3",
      "5",
      "5",
      "replacedB\nC",
      "8:8"
    ]
  },
  {
    "name": "range replacement selection modes and preserve overloads",
    "source": "const i=document.createElement('input');const state=()=>record(i.value+':'+i.selectionStart+':'+i.selectionEnd+':'+i.selectionDirection);for(const mode of ['select','start','end','preserve']){i.value='abcdefghij';i.setSelectionRange(7,9,'backward');i.setRangeText('XY',1,4,mode);state()}i.value='abcdef';i.setSelectionRange(1,4,'backward');i.setRangeText('XY');state();i.value='abcdef';i.setSelectionRange(1,5,'forward');i.setRangeText('XY',2,4);state()",
    "expected": [
      "aXYefghij:1:3:none",
      "aXYefghij:1:1:none",
      "aXYefghij:3:3:none",
      "aXYefghij:6:8:none",
      "aXYef:1:3:none",
      "abXYef:1:5:none"
    ],
    "difference": "The reference browser uses the platform default forward direction when this profile returns none. Both retain interoperable preserve-delta adjustment for explicit range arguments, beyond the current HTML draft one-argument wording.",
    "browserExpected": [
      "aXYefghij:1:3:forward",
      "aXYefghij:1:1:forward",
      "aXYefghij:3:3:forward",
      "aXYefghij:6:8:forward",
      "aXYef:1:3:forward",
      "abXYef:1:5:forward"
    ]
  },
  {
    "name": "value assignment default value reset and cloning",
    "source": "const f=document.createElement('form'),i=document.createElement('input');f.appendChild(i);i.defaultValue='abcdef';i.setSelectionRange(1,4,'backward');i.value='abcdef';record(i.selectionStart+':'+i.selectionEnd+':'+i.selectionDirection);i.value='abcdefgh';record(i.selectionStart+':'+i.selectionEnd+':'+i.selectionDirection);i.setSelectionRange(2,7,'forward');i.defaultValue='abc';record(i.value);f.reset();record(i.value+':'+i.selectionStart+':'+i.selectionEnd+':'+i.selectionDirection);i.value='copied';i.setSelectionRange(2,4,'backward');const copy=i.cloneNode();record(copy.value+':'+copy.selectionStart+':'+copy.selectionEnd+':'+copy.selectionDirection)",
    "expected": [
      "1:4:backward",
      "8:8:none",
      "abcdefgh",
      "abc:2:3:forward",
      "copied:0:0:none"
    ],
    "browserExpected": [
      "1:4:backward",
      "8:8:forward",
      "abcdefgh",
      "abc:3:3:forward",
      "copied:0:0:forward"
    ],
    "difference": "The reference browser uses forward as its platform default and collapses reset selection to the new end. This profile applies the generic relevant-value clamp specified by HTML for reset."
  },
