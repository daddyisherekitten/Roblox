      "InvalidStateError",
      "11",
      "true",
      "InvalidStateError",
      "11",
      "true",
      "true",
      "IndexSizeError",
      "1"
    ]
  },
  {
    "name": "range text is a script edit without input or DOM mutation",
    "async": true,
    "source": "const i=document.createElement('input');i.value='abcdef';i.setAttribute('maxlength','2');document.body.appendChild(i);let inputs=0,changes=0,mutations=0;i.addEventListener('input',()=>inputs++);i.addEventListener('change',()=>changes++);new MutationObserver(records=>{mutations+=records.length}).observe(i,{attributes:true,childList:true,characterData:true});i.readOnly=true;await Promise.resolve();mutations=0;i.setSelectionRange(1,4,'backward');i.setRangeText('long replacement');record(i.value);record(i.selectionStart+':'+i.selectionEnd);await Promise.resolve();record(inputs+':'+changes+':'+mutations);record(i.defaultValue)",
    "expected": [
      "along replacementef",
      "1:17",
      "0:0:0",
      ""
    ]
  },
  {
    "name": "textarea nonnullable setters and unsigned conversion",
    "source": "const t=document.createElement('textarea');t.value='abcdefgh';t.setSelectionRange(1,4,'backward');t.selectionStart=4294967297;record(t.selectionStart+':'+t.selectionEnd+':'+t.selectionDirection);t.selectionEnd=2.9;record(t.selectionStart+':'+t.selectionEnd);t.selectionEnd=NaN;record(t.selectionStart+':'+t.selectionEnd);t.setSelectionRange(Infinity,-Infinity);record(t.selectionStart+':'+t.selectionEnd);try{t.selectionDirection=Symbol()}catch(e){record(e.name)}",
    "expected": [
