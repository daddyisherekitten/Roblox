    "name": "initial selections and supported input types",
    "source": "for(const type of ['text','search','url','tel','password','unknown']){const i=document.createElement('input');i.setAttribute('type',type);i.defaultValue='abcdef';record(i.selectionStart+':'+i.selectionEnd+':'+i.selectionDirection);i.setSelectionRange(1,4,'backward');record(i.selectionStart+':'+i.selectionEnd+':'+i.selectionDirection);i.select();record(i.selectionStart+':'+i.selectionEnd+':'+i.selectionDirection)}",
