[
 {"name":"dialog defaults and closedBy reflection","source":"const d=document.getElementById('d');record(d.open+'|'+d.returnValue+'|'+d.closedBy);d.closedBy='ANY';record(d.closedBy+'|'+d.getAttribute('closedby'));d.closedBy='invalid';record(d.closedBy);d.showModal();record(d.open+'|'+d.closedBy+'|'+d.matches(':modal'));d.close('done');record(d.open+'|'+d.returnValue+'|'+d.closedBy);","expected":["false||none","any|ANY","none","true|closerequest|true","false|done|none"]},
 {"name":"same-mode idempotence and cross-mode exceptions","source":"const d=document.getElementById('d');d.show();d.show();try{d.showModal()}catch(e){record(e.name+'|'+(e instanceof DOMException))}d.close();d.showModal();d.showModal();try{d.show()}catch(e){record(e.name+'|'+(e instanceof DOMException))}record(d.open);d.close();","expected":["InvalidStateError|true","InvalidStateError|true","true"]},
 {"name":"cancelable opening and request-close cancellation","source":"const d=document.getElementById('d');function prevent(e){e.preventDefault()}d.addEventListener('beforetoggle',prevent);d.showModal();record(d.open);d.removeEventListener('beforetoggle',prevent);d.showModal();d.addEventListener('cancel',prevent);d.requestClose('blocked');record(d.open+'|'+d.returnValue);d.removeEventListener('cancel',prevent);d.closedBy='none';d.requestClose('saved');record(d.open+'|'+d.returnValue);","expected":["false","true|","false|saved"]},
 {"name":"dialog event order and task coalescing","source":"const d=document.getElementById('d');d.addEventListener('beforetoggle',e=>record('before:'+e.oldState+'>'+e.newState+'|'+e.cancelable+'|'+e.bubbles+'|'+e.isTrusted+'|'+(e instanceof ToggleEvent)));d.addEventListener('cancel',e=>record('cancel:'+e.cancelable+'|'+e.bubbles));d.addEventListener('toggle',e=>record('toggle:'+e.oldState+'>'+e.newState));d.addEventListener('close',()=>record('close'));d.showModal();d.requestClose('ok');d.show();record('sync:'+d.open);","expected":["before:closed>open|true|false|true|true","cancel:true|false","before:open>closed|false|false|true|true","before:closed>open|true|false|true|true","sync:true","close","toggle:closed>open"]},
 {"name":"direct dialog open attribute emits no close or toggle","source":"const d=document.getElementById('d');let calls=0;d.addEventListener('toggle',()=>calls++);d.addEventListener('close',()=>calls++);d.open=true;record(d.open+'|'+d.matches(':modal'));d.open=false;record(d.open+'|'+calls);d.returnValue='kept';d.close('ignored');record(d.returnValue);","expected":["true|false","false|0","kept"]},
 {"name":"detached dialogs and requestClose do not force connection","source":"const d=document.createElement('dialog');d.show();record(d.open);d.requestClose('ignored');record(d.open+'|'+d.returnValue);d.close();try{d.showModal()}catch(e){record(e.name)}record(d.open);","expected":["true","true|","InvalidStateError","false"]},
 {"name":"dialog methods brand and conversion","source":"const d=document.getElementById('d');record(d.show.name+'|'+d.show.length+'|'+d.close.length);try{d.show.call(document.body)}catch(e){record(e.name)}d.show();d.close({toString(){return 'object'}});record(d.returnValue);d.show();try{d.close(Symbol('value'))}catch(e){record(e.name+'|'+d.open)}d.close(undefined);record(d.returnValue);","expected":["show|0|0","TypeError","object","TypeError|true","object"]},
 {"name":"beforetoggle can change open or detach modal","source":"const d=document.getElementById('d');d.addEventListener('beforetoggle',()=>{d.open=true},{once:true});d.showModal();record(d.open+'|'+d.matches(':modal'));d.close();d.addEventListener('beforetoggle',()=>d.remove(),{once:true});d.showModal();record(d.isConnected+'|'+d.open);","expected":["true|false","false|false"]},
 {"name":"popover reflection and no-op return","source":"const p=document.getElementById('p');record(p.popover);p.popover='';record(p.popover);p.popover='INVALID';record(p.popover+'|'+p.getAttribute('popover'));p.popover='AUTO';record(p.popover);record(p.togglePopover(true));record(p.togglePopover(true));record(p.togglePopover(false));record(p.togglePopover(false));p.popover=null;record(p.popover);","expected":["auto","auto","manual|INVALID","auto","true","true","false","false","null"]},
 {"name":"invalid missing detached and modal popovers","source":"const box=document.createElement('div');try{box.showPopover()}catch(e){record(e.name+'|'+(e instanceof DOMException))}box.popover='auto';try{box.togglePopover(false)}catch(e){record(e.name)}document.body.append(box);box.showPopover();record(box.matches(':popover-open'));box.remove();record(box.matches(':popover-open'));const d=document.getElementById('d');d.popover='manual';d.showModal();try{d.showPopover()}catch(e){record(e.name)}d.close();","expected":["NotSupportedError|true","InvalidStateError","true","false","InvalidStateError"]},
 {"name":"popover source and event source clearing on hide","source":"const p=document.getElementById('p'),s=document.getElementById('s');p.addEventListener('beforetoggle',e=>record(e.oldState+'>'+e.newState+'|'+e.cancelable+'|'+(e.source===s)));p.addEventListener('toggle',e=>record('toggle:'+e.oldState+'>'+e.newState+'|'+(e.source===null)));p.showPopover({source:s});p.togglePopover({force:false,source:s});","expected":["closed>open|true|true","open>closed|false|false","toggle:closed>closed|true"]},
 {"name":"popover opening cancellation and closing cannot be canceled","source":"const p=document.getElementById('p');function prevent(e){e.preventDefault()}p.addEventListener('beforetoggle',prevent);record(p.togglePopover(true));p.removeEventListener('beforetoggle',prevent);p.showPopover();p.addEventListener('beforetoggle',prevent);record(p.togglePopover(false));","expected":["false","false"]},
 {"name":"popover dictionary conversion and method brands","source":"const p=document.getElementById('p');for(const v of [1,'x',Symbol('x'),1n]){try{p.showPopover(v)}catch(e){record(e.name)}}try{p.showPopover({source:document.createTextNode('x')})}catch(e){record(e.name)}try{p.showPopover.call(document)}catch(e){record(e.name)}record(p.showPopover.name+'|'+p.showPopover.length+'|'+p.togglePopover.length);","expected":["TypeError","TypeError","TypeError","TypeError","TypeError","TypeError","showPopover|0|0"]},
 {"name":"auto manual and hint stacks","source":"const p=document.getElementById('p'),q=document.getElementById('q'),m=document.getElementById('m'),h=document.getElementById('h');m.showPopover();p.showPopover();h.showPopover();record(p.matches(':popover-open')+'|'+h.matches(':popover-open')+'|'+m.matches(':popover-open'));q.showPopover();record(p.matches(':popover-open')+'|'+q.matches(':popover-open')+'|'+h.matches(':popover-open')+'|'+m.matches(':popover-open'));","expected":["true|true|true","false|true|false|true"]},
 {"name":"source relationship keeps parent auto open","source":"const p=document.getElementById('p'),q=document.getElementById('q'),s=document.getElementById('inside');p.showPopover();q.showPopover({source:s});record(p.matches(':popover-open')+'|'+q.matches(':popover-open'));p.hidePopover();record(p.matches(':popover-open')+'|'+q.matches(':popover-open'));","expected":["true|true","false|false"]},
 {"name":"same popover enum mutation stays open","source":"const p=document.getElementById('p');p.showPopover();p.setAttribute('popover','AUTO');record(p.matches(':popover-open'));p.popover='';record(p.matches(':popover-open'));p.popover='manual';record(p.matches(':popover-open'));","expected":["true","true","false"]},
 {"name":"popover attribute removed inside opening event","source":"const p=document.getElementById('p');p.addEventListener('beforetoggle',()=>p.removeAttribute('popover'),{once:true});try{p.showPopover()}catch(e){record(e.name)}record(p.matches(':popover-open'));","expected":["NotSupportedError","false"]},
 {"name":"dialog showing hides unrelated auto but keeps manual","source":"const d=document.getElementById('d'),p=document.getElementById('p'),m=document.getElementById('m');p.showPopover();m.showPopover();d.showModal();record(d.matches(':modal')+'|'+p.matches(':popover-open')+'|'+m.matches(':popover-open'));d.close();","expected":["true|false|true"]},
 {"name":"dialog cannot become modal while showing as popover","source":"const d=document.getElementById('d');d.popover='manual';d.showPopover();try{d.showModal()}catch(e){record(e.name)}record(d.open+'|'+d.matches(':popover-open'));d.hidePopover();d.showModal();record(d.open+'|'+d.matches(':modal'));","expected":["InvalidStateError","false|true","true|true"]},
 {"name":"ToggleEvent defaults conversion inheritance and readonly","source":"const e=new ToggleEvent('toggle');record(e.oldState+'|'+e.newState+'|'+e.source+'|'+e.bubbles+'|'+e.cancelable+'|'+(e instanceof Event));const s=document.getElementById('s'),v=new ToggleEvent('beforetoggle',{oldState:null,newState:7,source:s,cancelable:true});record(v.oldState+'|'+v.newState+'|'+(v.source===s));try{new ToggleEvent('x',{source:document})}catch(e){record(e.name)}const get=Object.getOwnPropertyDescriptor(ToggleEvent.prototype,'oldState').get;try{get.call({})}catch(e){record(e.name)}v.oldState='bad';record(v.oldState);","expected":["||null|false|false|true","null|7|true","TypeError","TypeError","null"]},
 {"name":"popover recursive same-node show terminates without duplicate events","source":"const p=document.getElementById('p');let n=0;p.addEventListener('beforetoggle',()=>{n++;p.showPopover()});p.showPopover();record(n+'|'+p.matches(':popover-open'));","expected":["1|true"]}
