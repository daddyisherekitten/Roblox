[
 {"name":"Classic ready protocol, bidirectional transfer and isolated globals","type":"classic","entry":"classic.js","sources":{"classic.js":"onmessage=e=>{const a=new Uint8Array(e.data);postMessage([a[0],typeof document,typeof window,self===globalThis],[]);postMessage(a.buffer,[a.buffer]);};postMessage('ready');"},"source":"const values=[];const w=new Worker('./classic.js');w.onmessage=e=>{if(e.data==='ready'){const a=new Uint8Array([7,9]);w.postMessage(a.buffer,[a.buffer]);values.push('detached:'+a.byteLength);}else if(e.data instanceof ArrayBuffer){values.push(new Uint8Array(e.data).join(','));console.log(values.join('|'));w.terminate();}else{values.push(e.data.join(','));}};","expected":"detached:0|7,undefined,undefined,true|7,9"},
 {"name":"Handler after top-level await loses early messages","type":"module","entry":"late.js","sources":{"late.js":"await new Promise(r=>setTimeout(r,25));onmessage=e=>postMessage(e.data);postMessage('ready');"},"source":"const values=[];const w=new Worker('./late.js',{type:'module'});w.postMessage('early');w.onmessage=e=>{values.push(e.data);if(e.data==='ready')w.postMessage('after');else{console.log(values.join('|'));w.terminate();}};","expected":"ready|after"},
 {"name":"Handler before top-level await already receives messages","type":"module","entry":"early.js","sources":{"early.js":"onmessage=e=>postMessage(e.data);await new Promise(r=>setTimeout(r,25));postMessage('ready');"},"source":"const values=[];const w=new Worker('./early.js',{type:'module'});w.postMessage('early');w.onmessage=e=>{values.push(e.data);if(values.length===2){console.log(values.join('|'));w.terminate();}};","expected":"early|ready"},
 {"name":"A classic startup runtime exception leaves installed handlers alive","type":"classic","entry":"throw.js","sources":{"throw.js":"onmessage=()=>postMessage('alive');throw new Error('startup');"},"source":"const values=[];const w=new Worker('./throw.js');w.onerror=e=>{e.preventDefault();values.push('error');};w.onmessage=e=>{values.push(e.data);console.log(values.join('|'));w.terminate();};w.postMessage(1);","expected":"error|alive"},
 {"name":"Canceling the worker's own error prevents parent propagation","type":"classic","entry":"error.js","sources":{"error.js":"addEventListener('error',e=>{e.preventDefault();postMessage('handled');});onmessage=()=>{throw new Error('local');};"},"source":"const w=new Worker('./error.js');w.onerror=e=>{e.preventDefault();console.log('unexpected');};w.onmessage=e=>{console.log(e.data);w.terminate();};w.postMessage(1);","expected":"handled"},
 {"name":"Legacy global onerror uses five arguments and true cancels reporting","type":"classic","entry":"legacy.js","sources":{"legacy.js":"onerror=(message,filename,line,column,error)=>{postMessage([typeof message,typeof filename,typeof line,typeof column,error.message].join('|'));return true;};onmessage=()=>{throw new Error('local');};"},"source":"const w=new Worker('./legacy.js');w.onerror=e=>{e.preventDefault();console.log('unexpected');};w.onmessage=e=>{console.log(e.data);w.terminate();};w.postMessage(1);","expected":"string|string|number|number|local"},
 {"name":"close completes the current task and its microtasks only","type":"classic","entry":"close.js","sources":{"close.js":"onmessage=()=>{close();postMessage('last');queueMicrotask(()=>postMessage('micro'));};"},"source":"const values=[];const w=new Worker('./close.js');w.onmessage=e=>{values.push(e.data);if(values.length===2)console.log(values.join('|'));};w.postMessage(1);w.postMessage(2);","expected":"last|micro"},
 {"name":"Modules have no importScripts and their own location","type":"module","entry":"module.js","sources":{"module.js":"import {n} from './helper.js';onmessage=()=>{try{importScripts('helper.js');}catch(e){postMessage([n,e.name,location.pathname.split('/').pop(),name].join('|'));}};","helper.js":"export const n=42;"},"source":"const w=new Worker('./module.js',{type:'module',name:'isolated'});w.onmessage=e=>{console.log(e.data);w.terminate();};w.postMessage(1);","expected":"42|TypeError|module.js|isolated"}
]
