      "code": "const s=document.getElementById('s'),o=document.getElementById('o');record(o.text,o.value,o.label,s.value);o.label='';record(o.text,o.value,o.label);o.removeAttribute('label');record(o.label);o.text=' Changed  text ';record(o.text,o.value,o.label,o.textContent);",
